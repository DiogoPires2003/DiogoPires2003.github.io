        <script is:inline>
            function playWelcomeAnimation() {
                if (!window.__playWelcome) return;
                window.__playWelcome = false;

                var overlay = document.getElementById("welcome-overlay");
                if (!overlay) return;

                try {
                    sessionStorage.setItem("welcomed", "1");
                } catch (e) {}

                var dotEl = document.getElementById("welcome-word-dot");
                var skipEl = document.getElementById("welcome-skip");
                var progressEl = document.getElementById("welcome-progress");
                if (progressEl) progressEl.classList.add("is-running");
                var timers = [];
                var done = false;

                var at = function (ms, fn) {
                    timers.push(setTimeout(fn, ms));
                };

                var setWord = function (text, stamp) {
                    if (window.__welcomeMorphUpdate) {
                        window.__welcomeMorphUpdate(text);
                    }
                    if (stamp && dotEl) {
                        dotEl.classList.remove("is-stamped");
                        void dotEl.offsetWidth;
                        dotEl.classList.add("is-stamped");
                    }
                };

                // Deliberate input leaves immediately, but only once the
                // intro has had a moment to speak: a leftover click from the
                // previous page or a stray trackpad nudge must not kill it.
                var armed = false;

                var onSkipPointer = function () {
                    if (armed) leave();
                };
                var onSkipKey = function (event) {
                    if (!armed || event.key === "Tab") return;
                    leave();
                };
                var onSkipWheel = function (event) {
                    if (armed && Math.abs(event.deltaY) > 8) leave();
                };
                var onSkipTouch = function () {
                    if (armed) leave();
                };
                var detach = function () {
                    window.removeEventListener("pointerdown", onSkipPointer);
                    window.removeEventListener("keydown", onSkipKey);
                    window.removeEventListener("wheel", onSkipWheel);
                    window.removeEventListener("touchmove", onSkipTouch);
                };

                function leave() {
                    if (done) return;
                    done = true;
                    timers.forEach(clearTimeout);
                    timers.length = 0;
                    detach();
                    overlay.classList.add("is-leaving");
                    document.body.style.overflow = "";
                    setTimeout(function () {
                        overlay.remove();
                    }, 800);
                }

                window.addEventListener("pointerdown", onSkipPointer);
                window.addEventListener("keydown", onSkipKey);
                window.addEventListener("wheel", onSkipWheel, { passive: true });
                window.addEventListener("touchmove", onSkipTouch, { passive: true });

                setWord("DRIVEN.");
                at(650, function () {
                    setWord("CURIOUS.");
                });
                at(620, function () {
                    armed = true;
                    if (skipEl) skipEl.style.opacity = "1";
                });
                at(1300, function () {
                    setWord("RELENTLESS.");
                });
                at(2000, function () {
                    setWord("DIOGO PIRES", true);
                    var word = document.getElementById("welcome-word");
                    if (word) word.classList.add("glitch");
                });
                at(2950, leave);
            }

            function initMotion() {
                var reduced = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;
                var glyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#_";

                var scramble = function (el) {
                    var finalText = (el.dataset.text || el.textContent).trim();
                    el.dataset.text = finalText;
                    if (reduced) return;
                    var frame = 0;
                    clearInterval(el._scrambleTimer);
                    el._scrambleTimer = setInterval(function () {
                        frame += 1.2;
                        el.textContent = finalText
                            .split("")
                            .map(function (c, i) {
                                return c === " " || i < frame
                                    ? c
                                    : glyphs[(Math.random() * glyphs.length) | 0];
                            })
                            .join("");
                        if (frame >= finalText.length) {
                            clearInterval(el._scrambleTimer);
                            el.textContent = finalText;
                        }
                    }, 28);
                };

                var countUp = function (el) {
                    var to = parseFloat(el.dataset.countText);
                    var suffix = el.dataset.suffix || "";
                    // A backgrounded tab freezes rAF, which would leave the
                    // figure stranded at 0. The real value is never worth
                    // trading for an animation nobody is watching.
                    if (reduced || document.hidden) {
                        el.textContent = to + suffix;
                        return;
                    }
                    var start = performance.now() + 200;
                    var tick = function (t) {
                        if (document.hidden) {
                            el.textContent = to + suffix;
                            return;
                        }
                        var p = Math.max(0, Math.min(1, (t - start) / 900));
                        p = 1 - Math.pow(1 - p, 4);
                        el.textContent = Math.round(to * p) + suffix;
                        if (p < 1) requestAnimationFrame(tick);
                    };
                    requestAnimationFrame(tick);
                };

                var onEnter = function (el) {
                    el.classList.add("is-in");
                    if (el.hasAttribute("data-scramble")) scramble(el);
                    el.querySelectorAll("[data-scramble]").forEach(scramble);
                    if (el.hasAttribute("data-count-text")) countUp(el);
                };

                var targets = document.querySelectorAll(
                    "[data-reveal], [data-scramble], [data-count-text]"
                );
                if ("IntersectionObserver" in window && !reduced) {
                    var io = new IntersectionObserver(
                        function (entries) {
                            entries.forEach(function (entry) {
                                if (entry.isIntersecting) {
                                    onEnter(entry.target);
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.2 }
                    );
                    targets.forEach(function (el) {
                        io.observe(el);
                    });
                } else {
                    targets.forEach(onEnter);
                }

                // Collections cascade in rather than appearing all at once.
                // Shared by the highlight grid, the milestone list and the
                // skills table so each page doesn't need its own observer.
                window.__showStagger = function (items, step) {
                    items.forEach(function (item, i) {
                        item.style.setProperty("--stagger", i * (step || 55));
                        item.classList.add("is-shown");
                    });
                };

                document.querySelectorAll("[data-stagger]").forEach(function (group) {
                    var items = Array.prototype.slice.call(
                        group.querySelectorAll(".stagger-item")
                    );
                    if (!items.length) return;
                    var step = parseInt(group.dataset.stagger, 10) || 55;
                    var show = function () {
                        window.__showStagger(items, step);
                    };
                    if ("IntersectionObserver" in window && !reduced) {
                        var gio = new IntersectionObserver(
                            function (entries) {
                                entries.forEach(function (entry) {
                                    if (entry.isIntersecting) {
                                        show();
                                        gio.disconnect();
                                    }
                                });
                            },
                            { threshold: 0.15 }
                        );
                        gio.observe(group);
                    } else {
                        show();
                    }
                });

                var place = function (ink, el, axis) {
                    if (!ink) return;
                    if (!el) {
                        ink.style.setProperty("--o", 0);
                        return;
                    }
                    ink.style.setProperty("--x", el.offsetLeft + "px");
                    ink.style.setProperty("--w", el.offsetWidth + "px");
                    ink.style.setProperty("--o", 1);
                };

                var nav = document.getElementById("desktop-nav");
                var navInk = document.getElementById("nav-ink");
                if (nav && navInk) {
                    var links = nav.querySelectorAll("a");
                    var current = nav.querySelector("[aria-current]");
                    place(navInk, current);
                    links.forEach(function (link) {
                        link.addEventListener("mouseenter", function () {
                            place(navInk, link);
                        });
                    });
                    nav.addEventListener("mouseleave", function () {
                        place(navInk, current);
                    });
                    window.addEventListener("resize", function () {
                        place(navInk, current);
                    });
                    // Archivo swaps in after first paint and changes the link
                    // widths, so the indicator has to be measured again.
                    if (document.fonts && document.fonts.ready) {
                        document.fonts.ready.then(function () {
                            place(navInk, current);
                        });
                    }
                }

                var grid = document.getElementById("highlight-grid");
                var gridInk = document.getElementById("highlight-ink");
                if (grid && gridInk) {
                    var items = grid.querySelectorAll(".highlight-item");
                    items.forEach(function (item) {
                        item.addEventListener("mouseenter", function () {
                            if (window.innerWidth < 768) return;
                            items.forEach(function (x) {
                                x.classList.toggle("is-hot", x === item);
                            });
                            place(gridInk, item);
                            var title = item.querySelector("h3");
                            if (title) scramble(title);
                        });
                    });
                    grid.addEventListener("mouseleave", function () {
                        items.forEach(function (x) {
                            x.classList.remove("is-hot");
                        });
                        place(gridInk, null);
                    });
                }

                if (!reduced && window.matchMedia("(pointer: fine)").matches) {
                    document.querySelectorAll(".magnetic").forEach(function (btn) {
                        // The offset goes into custom properties rather than
                        // onto `transform`, so the :active press scale still
                        // applies to the same element.
                        var dx = 0;
                        var dy = 0;
                        var frame = null;

                        btn.addEventListener("pointermove", function (e) {
                            var cx = e.clientX;
                            var cy = e.clientY;
                            if (frame) return;
                            frame = requestAnimationFrame(function () {
                                frame = null;
                                var r = btn.getBoundingClientRect();
                                // Subtract the offset already applied so the
                                // element can't chase its own transform.
                                var midX = r.left + r.width / 2 - dx;
                                var midY = r.top + r.height / 2 - dy;
                                dx = (cx - midX) * 0.18;
                                dy = (cy - midY) * 0.3;
                                btn.style.setProperty("--mx", dx.toFixed(2) + "px");
                                btn.style.setProperty("--my", dy.toFixed(2) + "px");
                            });
                        });

                        btn.addEventListener("pointerleave", function () {
                            if (frame) {
                                cancelAnimationFrame(frame);
                                frame = null;
                            }
                            dx = 0;
                            dy = 0;
                            btn.style.setProperty("--mx", "0px");
                            btn.style.setProperty("--my", "0px");
                        });
                    });
                }
            }

            function bindPerPageInteractions() {
                playWelcomeAnimation();
                initMotion();

                var themeToggleBtn = document.getElementById("theme-toggle");
                var themeToggleIcon = document.getElementById("theme-toggle-icon");
                var updateThemeIcon = function () {
                    if (!themeToggleIcon) return;
                    themeToggleIcon.textContent = document.documentElement.classList.contains(
                        "dark"
                    )
                        ? "light_mode"
                        : "dark_mode";
                };
                var applyTheme = function () {
                    var isDark = document.documentElement.classList.toggle("dark");
                    localStorage.setItem("theme", isDark ? "dark" : "light");
                    updateThemeIcon();
                    if (window.syncThemeColorMeta) window.syncThemeColorMeta(isDark);
                    if (themeToggleIcon) {
                        themeToggleIcon.classList.remove("is-swapping");
                        void themeToggleIcon.offsetWidth;
                        themeToggleIcon.classList.add("is-swapping");
                    }
                };

                // The new theme is revealed from under a still of the old one,
                // centred on whatever triggered the change.
                var toggleTheme = function (origin) {
                    var reduced = window.matchMedia(
                        "(prefers-reduced-motion: reduce)"
                    ).matches;
                    var wasDark = document.documentElement.classList.contains("dark");

                    if (reduced || typeof document.body.animate !== "function") {
                        applyTheme();
                        return;
                    }

                    var old = document.getElementById("theme-wipe");
                    if (old) old.remove();

                    var x = window.innerWidth / 2;
                    var y = window.innerHeight / 2;
                    var source = origin || themeToggleBtn;
                    if (source && source.getBoundingClientRect) {
                        var r = source.getBoundingClientRect();
                        if (r.width) {
                            x = r.left + r.width / 2;
                            y = r.top + r.height / 2;
                        }
                    }

                    var wipe = document.createElement("div");
                    wipe.id = "theme-wipe";
                    wipe.setAttribute("aria-hidden", "true");
                    wipe.style.setProperty("--wipe-x", x + "px");
                    wipe.style.setProperty("--wipe-y", y + "px");
                    wipe.style.setProperty("--wipe-bg", wasDark ? "#0a0a0a" : "#ffffff");
                    document.body.appendChild(wipe);

                    // Flip the theme underneath before the circle starts closing.
                    applyTheme();
                    void wipe.offsetWidth;
                    wipe.classList.add("is-wiping");

                    var done = false;
                    var cleanup = function () {
                        if (done) return;
                        done = true;
                        wipe.remove();
                    };
                    wipe.addEventListener("animationend", cleanup);
                    setTimeout(cleanup, 900);
                };
                updateThemeIcon();
                themeToggleBtn?.addEventListener("click", function () {
                    toggleTheme(themeToggleBtn);
                });

                var mobileToggle = document.getElementById("mobile-menu-toggle");
                var mobileMenu = document.getElementById("mobile-menu");
                if (mobileToggle && mobileMenu) {
                    var menuCloseTimer;

                    var closeMenu = function () {
                        clearTimeout(menuCloseTimer);
                        mobileMenu.classList.remove("opacity-100", "translate-y-0");
                        mobileMenu.classList.add("opacity-0", "-translate-y-2");
                        mobileMenu.setAttribute("aria-hidden", "true");
                        mobileToggle.setAttribute("aria-expanded", "false");
                        document.body.style.overflow = "";
                        menuCloseTimer = setTimeout(function () {
                            mobileMenu.classList.add("hidden");
                        }, 200);
                    };

                    var openMenu = function () {
                        clearTimeout(menuCloseTimer);
                        mobileMenu.classList.remove("hidden");
                        void mobileMenu.offsetWidth;
                        mobileMenu.classList.remove("opacity-0", "-translate-y-2");
                        mobileMenu.classList.add("opacity-100", "translate-y-0");
                        mobileMenu.setAttribute("aria-hidden", "false");
                        mobileToggle.setAttribute("aria-expanded", "true");
                        document.body.style.overflow = "hidden";
                    };

                    mobileToggle.addEventListener("click", function () {
                        var isExpanded =
                            mobileToggle.getAttribute("aria-expanded") === "true";
                        if (isExpanded) {
                            closeMenu();
                        } else {
                            openMenu();
                        }
                    });

                    mobileMenu.querySelectorAll("a").forEach(function (link) {
                        link.addEventListener("click", closeMenu);
                    });

                    mobileMenu.addEventListener("click", function (event) {
                        if (event.target === mobileMenu) {
                            closeMenu();
                            document.body.style.overflow = "";
                        }
                    });

                    window.__closeMobileMenu = function () {
                        if (mobileToggle.getAttribute("aria-expanded") !== "true") {
                            return false;
                        }
                        closeMenu();
                        mobileToggle.focus();
                        return true;
                    };
                }

                var palette = document.getElementById("command-palette");
                var paletteInput = document.getElementById("command-input");
                var paletteItems = Array.from(
                    document.querySelectorAll(".command-item")
                );
                var activeIndex = -1;

                var setActive = function (index) {
                    var visible = paletteItems.filter(
                        (item) => !item.classList.contains("hidden")
                    );
                    paletteItems.forEach((item) => item.classList.remove("is-active"));
                    if (!visible.length) {
                        activeIndex = -1;
                        return;
                    }
                    activeIndex = ((index % visible.length) + visible.length) % visible.length;
                    visible[activeIndex].classList.add("is-active");
                    visible[activeIndex].scrollIntoView({ block: "nearest" });
                };

                var paletteReturnFocus = null;

                var openPalette = function () {
                    if (!palette) return;
                    paletteReturnFocus = document.activeElement;
                    palette.classList.remove("hidden");
                    palette.classList.add("flex");
                    document.body.style.overflow = "hidden";
                    if (paletteInput) {
                        paletteInput.value = "";
                        paletteItems.forEach((item) => item.classList.remove("hidden"));
                        setActive(0);
                        paletteInput.focus();
                    }
                };

                var closePalette = function () {
                    if (!palette) return;
                    if (palette.classList.contains("hidden")) return;
                    palette.classList.add("hidden");
                    palette.classList.remove("flex");
                    document.body.style.overflow = "";
                    if (paletteReturnFocus && paletteReturnFocus.focus) {
                        paletteReturnFocus.focus();
                    }
                    paletteReturnFocus = null;
                };

                document
                    .getElementById("command-trigger")
                    ?.addEventListener("click", openPalette);
                document
                    .getElementById("command-trigger-mobile")
                    ?.addEventListener("click", openPalette);
                document
                    .getElementById("command-theme-toggle")
                    ?.addEventListener("click", function (event) {
                        toggleTheme(event.currentTarget);
                        closePalette();
                    });

                palette?.addEventListener("click", function (event) {
                    if (event.target === palette) closePalette();
                });

                paletteItems.forEach((item) => {
                    item.addEventListener("click", () => closePalette());
                });

                paletteInput?.addEventListener("input", () => {
                    var query = paletteInput.value.trim().toLowerCase();
                    paletteItems.forEach((item) => {
                        var label = (item.dataset.commandLabel || "").toLowerCase();
                        item.classList.toggle("hidden", query.length > 0 && !label.includes(query));
                    });
                    setActive(0);
                });

                paletteInput?.addEventListener("keydown", (event) => {
                    var visible = paletteItems.filter(
                        (item) => !item.classList.contains("hidden")
                    );
                    if (event.key === "ArrowDown") {
                        event.preventDefault();
                        setActive(activeIndex + 1);
                    } else if (event.key === "ArrowUp") {
                        event.preventDefault();
                        setActive(activeIndex - 1);
                    } else if (event.key === "Enter") {
                        event.preventDefault();
                        if (activeIndex >= 0 && visible[activeIndex]) {
                            visible[activeIndex].click();
                        }
                    } else if (event.key === "Tab") {
                        // Arrow keys move through the list, so Tab has nowhere
                        // to go and must not escape behind the overlay.
                        event.preventDefault();
                    } else if (event.key === "Escape") {
                        closePalette();
                    }
                });

                document
                    .getElementById("to-top")
                    ?.addEventListener("click", function () {
                        var reducedMotion = window.matchMedia(
                            "(prefers-reduced-motion: reduce)"
                        ).matches;
                        window.scrollTo({
                            top: 0,
                            behavior: reducedMotion ? "auto" : "smooth",
                        });
                    });

                window.__closeCommandPalette = closePalette;
                window.__openCommandPalette = openPalette;
            }

            document.addEventListener("astro:page-load", bindPerPageInteractions);

            if (!window.__portfolioGlobalInit) {
                window.__portfolioGlobalInit = true;

                // scaleX stays on the compositor; animating width would force
                // layout and paint on every scroll event.
                var progressFrame = null;
                var updateScrollProgress = function () {
                    if (progressFrame) return;
                    progressFrame = requestAnimationFrame(function () {
                        progressFrame = null;
                        var bar = document.getElementById("scroll-progress");
                        if (!bar) return;
                        var docHeight =
                            document.documentElement.scrollHeight - window.innerHeight;
                        var p = docHeight > 0 ? window.scrollY / docHeight : 0;
                        bar.style.transform =
                            "scaleX(" + Math.min(1, Math.max(0, p)) + ")";

                        var toTop = document.getElementById("to-top");
                        if (toTop) {
                            toTop.classList.toggle(
                                "is-visible",
                                window.scrollY > window.innerHeight * 0.9
                            );
                        }
                    });
                };
                updateScrollProgress();
                window.addEventListener("scroll", updateScrollProgress, {
                    passive: true,
                });
                window.addEventListener("resize", function () {
                    updateScrollProgress();
                    if (window.innerWidth >= 768) {
                        var menu = document.getElementById("mobile-menu");
                        var toggle = document.getElementById("mobile-menu-toggle");
                        if (menu && toggle?.getAttribute("aria-expanded") === "true") {
                            menu.classList.remove("opacity-100", "translate-y-0");
                            menu.classList.add("opacity-0", "-translate-y-2", "hidden");
                            menu.setAttribute("aria-hidden", "true");
                            toggle.setAttribute("aria-expanded", "false");
                            document.body.style.overflow = "";
                        }
                    }
                });
                document.addEventListener("astro:after-swap", updateScrollProgress);

                document.addEventListener("keydown", function (event) {
                    var isK = event.key === "k" || event.key === "K";
                    if ((event.metaKey || event.ctrlKey) && isK) {
                        event.preventDefault();
                        var palette = document.getElementById("command-palette");
                        if (!palette) return;
                        if (palette.classList.contains("hidden")) {
                            window.__openCommandPalette?.();
                        } else {
                            window.__closeCommandPalette?.();
                        }
                    } else if (event.key === "Escape") {
                        if (window.__closeMobileMenu?.()) return;
                        window.__closeCommandPalette?.();
                    }
                });
            }
        </script>
    </body>
</html>
