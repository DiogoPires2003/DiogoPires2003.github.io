---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Diogo Pires - Software Engineer portfolio.",
} = Astro.props;

const ogImage = new URL("/og-image.jpg", Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

// Both halves are enters/exits, so both use ease-out. Leaving is quicker than
// arriving, which keeps navigation feeling immediate.
const editorialAnim = {
    old: {
        name: "editorial-page-out",
        duration: "140ms",
        easing: "cubic-bezier(0.23, 1, 0.32, 1)",
        fillMode: "both",
    },
    new: {
        name: "editorial-page-in",
        duration: "220ms",
        easing: "cubic-bezier(0.23, 1, 0.32, 1)",
        fillMode: "both",
    },
};
const editorialPageTransition = {
    forwards: editorialAnim,
    backwards: editorialAnim,
};
---

<!DOCTYPE html>
<html lang="en" transition:animate={editorialPageTransition}>
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <noscript
            ><style>
                /* Revealed collections are shown by script; without it they
                   must not stay invisible. */
                .stagger-item {
                    opacity: 1 !important;
                    transform: none !important;
                }
            </style></noscript
        >

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <ClientRouter />
        <script is:inline>
            function syncThemeColorMeta(isDark) {
                var meta = document.querySelector('meta[name="theme-color"]:not([media])');
                if (!meta) {
                    meta = document.createElement("meta");
                    meta.setAttribute("name", "theme-color");
                    document.head.appendChild(meta);
                }
                meta.setAttribute("content", isDark ? "#0a0a0a" : "#ffffff");
            }

            function applyStoredTheme() {
                var stored = localStorage.getItem("theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)"
                ).matches;
                var isDark = stored ? stored === "dark" : prefersDark;
                document.documentElement.classList.toggle("dark", isDark);
                if (stored) syncThemeColorMeta(isDark);
            }

            applyStoredTheme();

            if (!window.__themeInitBound) {
                window.__themeInitBound = true;
                document.addEventListener("astro:after-swap", applyStoredTheme);
            }
        </script>
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-paper dark:bg-ink font-sans text-ink dark:text-paper antialiased">
