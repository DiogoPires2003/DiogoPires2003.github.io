                    >TypeScript</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-accent"
                    style="left:42%;top:8%;--tech-op:0.4;--tech-duration:4600ms;--tech-delay:340ms;"
                    >Astro</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:4%;top:80%;--tech-op:0.28;--tech-duration:5000ms;--tech-delay:500ms;"
                    >PostgreSQL</span
                >
            </div>
            <div
                class="welcome-half welcome-half-bottom absolute inset-x-0 bottom-0 h-1/2 bg-paper dark:bg-ink"
            >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:12%;top:26%;--tech-op:0.3;--tech-duration:4400ms;--tech-delay:140ms;"
                    >Three.js</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-accent"
                    style="left:76%;top:20%;--tech-op:0.4;--tech-duration:4200ms;--tech-delay:300ms;"
                    >Django</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:34%;top:66%;--tech-op:0.3;--tech-duration:4800ms;--tech-delay:460ms;"
                    >Scala</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:82%;top:72%;--tech-op:0.28;--tech-duration:5000ms;--tech-delay:200ms;"
                    >Bash</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-accent"
                    style="left:8%;top:84%;--tech-op:0.36;--tech-duration:4000ms;--tech-delay:380ms;"
                    >JavaScript</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:55%;top:40%;--tech-op:0.3;--tech-duration:4600ms;--tech-delay:520ms;"
                    >C</span
                >
            </div>
            <div class="absolute inset-0 flex items-center justify-center px-6">
                <span
                    id="welcome-word"
                    class="welcome-word font-black uppercase text-ink dark:text-paper"
                ></span>
            </div>
        </div>
        <script is:inline>
            function evaluateWelcomeOverlay() {
                var overlay = document.getElementById("welcome-overlay");
                if (!overlay) return;

                var onHome = window.location.pathname === "/";
                var seen;
                try {
                    seen = localStorage.getItem("welcomed");
                } catch (e) {
                    seen = "1";
                }
                var reduced = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;

                var shouldPlay = onHome && !seen && !reduced;

                if (!shouldPlay) {
                    overlay.style.display = "none";
                    overlay.classList.remove("is-leaving");
                    if (onHome && !seen && reduced) {
                        try {
                            localStorage.setItem("welcomed", "1");
                        } catch (e) {}
                    }
                } else {
                    overlay.style.display = "";
                    document.body.style.overflow = "hidden";
                    window.__playWelcome = true;
                }
            }

            evaluateWelcomeOverlay();

            if (!window.__welcomeOverlayBound) {
                window.__welcomeOverlayBound = true;
                document.addEventListener("astro:page-load", evaluateWelcomeOverlay);
            }
        </script>
        <div
            id="scroll-progress"
            class="fixed top-0 left-0 h-[3px] bg-accent z-[70]"
            style="width: 0%"
        >
        </div>
        <div class="relative flex min-h-screen flex-col">
            <header
