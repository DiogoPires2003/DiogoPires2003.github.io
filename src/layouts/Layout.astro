                    <a
                        class:list={["font-mono text-xs uppercase tracking-widest px-5 h-full flex items-center border-l border-neutral-300 dark:border-neutral-700 hover:text-accent transition-colors", currentPath === "/academic" ? "text-accent" : undefined]}
                        href="/academic" aria-current={currentPath === "/academic" ? "page" : undefined}><span class="text-accent mr-2">03</span>Academic</a
                    >
                    <a
                        class:list={["font-mono text-xs uppercase tracking-widest px-5 h-full flex items-center border-l border-r border-neutral-300 dark:border-neutral-700 hover:text-accent transition-colors", currentPath === "/contact" ? "text-accent" : undefined]}
                        href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}><span class="text-accent mr-2">04</span>Contact</a
                    >
                </nav>
                <div class="flex items-center gap-2 sm:gap-3">
                    <button
                        id="command-trigger"
                        type="button"
                        title="Search (⌘K)"
