            <div class="absolute inset-0 flex items-center justify-center px-6">
                <span class="welcome-word-row font-black uppercase text-ink dark:text-paper">
                    <span id="welcome-word" class="welcome-word"></span
                    ><span id="welcome-word-dot" class="welcome-word-dot text-accent stamp-dot">.</span>
                </span>
<p
                    id="welcome-skip"
                    class="absolute inset-x-0 bottom-10 text-center font-mono text-[10px] uppercase tracking-[0.3em] text-neutral-500 dark:text-neutral-400"
                >
                    Click or press any key to skip
