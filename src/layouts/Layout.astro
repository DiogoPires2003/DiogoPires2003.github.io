                    id="welcome-progress"
                    class="absolute bottom-6 left-1/2 h-[2px] w-24 bg-accent"
                    aria-hidden="true"
                ></span>
            </div>
        </div>
        <script>
            import { TextMorph } from "torph";

            let welcomeMorph;

            function initWelcomeMorph() {
                var el = document.getElementById("welcome-word");
                if (!el || welcomeMorph) return;
                welcomeMorph = new TextMorph({
                    element: el,
                    duration: 350,
                    ease: "cubic-bezier(0.19, 1, 0.22, 1)",
                });
            }

            window.__welcomeMorphUpdate = function (text) {
                initWelcomeMorph();
                if (welcomeMorph) welcomeMorph.update(text);
            };

            document.addEventListener("astro:page-load", initWelcomeMorph);
        </script>
        <script is:inline>
            function evaluateWelcomeOverlay() {
                var overlay = document.getElementById("welcome-overlay");
                if (!overlay) return;

                var onHome = window.location.pathname === "/";
                var seen;
                try {
                    seen = sessionStorage.getItem("welcomed");
                } catch (e) {
                    seen = "1";
                }
                var reduced = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;

                var shouldPlay = onHome && !seen && !reduced;

                if (!shouldPlay) {
                    overlay.style.display = "none";
                    overlay.classList.remove("is-leaving");
                    if (onHome && !seen && reduced) {
                        try {
                            sessionStorage.setItem("welcomed", "1");
                        } catch (e) {}
                    }
                } else {
                    overlay.style.display = "";
                    document.body.style.overflow = "hidden";
                    window.__playWelcome = true;
                }
            }

            evaluateWelcomeOverlay();

            if (!window.__welcomeOverlayBound) {
                window.__welcomeOverlayBound = true;
                document.addEventListener("astro:page-load", evaluateWelcomeOverlay);
            }
        </script>
