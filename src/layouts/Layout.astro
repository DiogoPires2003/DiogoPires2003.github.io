                    <span class="font-black uppercase tracking-tight text-base sm:text-lg">
                        Diogo Pires
                    </span>
                </a>
                <nav class="hidden md:flex items-center h-full">
                    <a
                        class:list={["font-mono text-xs uppercase tracking-widest px-5 h-full flex items-center border-l border-neutral-300 dark:border-neutral-700 hover:text-accent transition-colors", currentPath === "/" ? "text-accent" : undefined]}
