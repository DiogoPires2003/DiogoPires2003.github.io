---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Diogo Pires - Software Engineer portfolio.",
} = Astro.props;

const ogImage = new URL("/og-image.jpg", Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Trailing slashes come and go between dev and the static build.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const sections = [
    { n: "1", label: "Profile", href: "/profile", cmd: "cd profile" },
    { n: "2", label: "Skills", href: "/skills", cmd: "cd skills" },
    { n: "3", label: "Projects", href: "/projects", cmd: "cd projects" },
    { n: "4", label: "Academic", href: "/academic", cmd: "cd academic" },
    { n: "5", label: "Contact", href: "/contact", cmd: "cd contact" },
];
const currentSection = sections.find((s) => s.href === currentPath);
const pathLabel =
    "C:\\DIOGO" +
    (currentPath === "/"
        ? ""
        : "\\" + (currentSection ? currentSection.label : "404").toUpperCase());

// Leaving is a channel switch: the old picture collapses to a line, the new
// one opens from it. The exit is quicker than the entrance, and the two
// together stay around 300ms because this plays on every navigation.
const channelSwitch = {
    old: {
        name: "crt-out",
        duration: "120ms",
        easing: "cubic-bezier(0.23, 1, 0.32, 1)",
        fillMode: "both",
    },
    new: {
        name: "crt-in",
        duration: "200ms",
        delay: "100ms",
        easing: "cubic-bezier(0.23, 1, 0.32, 1)",
        fillMode: "both",
    },
};
const crtSwitch = {
    forwards: channelSwitch,
    backwards: channelSwitch,
};

const keyRows = [
    [..."QWERTYUIOP"].map((k) => ({ label: k, code: k.toLowerCase() }))
        .concat([{ label: "⌫", code: "backspace", wide: true }]),
    [..."ASDFGHJKL"].map((k) => ({ label: k, code: k.toLowerCase() }))
        .concat([{ label: "Enter", code: "enter", wide: true }]),
    [..."ZXCVBNM"].map((k) => ({ label: k, code: k.toLowerCase() }))
        .concat([{ label: "", code: "space", space: true }]),
] as { label: string; code: string; wide?: boolean; space?: boolean }[][];
---

<!DOCTYPE html>
<html lang="en" transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#d9d4c8" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#060606" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <noscript
            ><style>
                /* Revealed collections are shown by script; without it they
                   must not stay invisible. */
                .stagger-item {
                    opacity: 1 !important;
                    transform: none !important;
                }
            </style></noscript
        >

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <ClientRouter />
        <script is:inline>
            function syncThemeColorMeta(isDark) {
                var meta = document.querySelector('meta[name="theme-color"]:not([media])');
                if (!meta) {
                    meta = document.createElement("meta");
                    meta.setAttribute("name", "theme-color");
                    document.head.appendChild(meta);
                }
                meta.setAttribute("content", isDark ? "#060606" : "#d9d4c8");
            }

            function applyStoredTheme() {
                var stored = localStorage.getItem("theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)"
                ).matches;
                var isDark = stored ? stored === "dark" : prefersDark;
                document.documentElement.classList.toggle("dark", isDark);
                if (stored) syncThemeColorMeta(isDark);
            }

            applyStoredTheme();

            // Every entry to the site boots the computer: a new tab, a reload or
            // a typed URL. Moving between sections is a client-side swap and
            // never reaches this. Decided before first paint so the content
            // never flashes ahead of the boot.
            if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                document.documentElement.dataset.boot = "1";
            }

            if (!window.__themeInitBound) {
                window.__themeInitBound = true;
                document.addEventListener("astro:after-swap", applyStoredTheme);
            }
        </script>
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="desk font-sans text-ink dark:text-paper antialiased">
        <div class="rig">
            <div class="crt" id="crt">
                <div class="crt-screen" id="crt-screen">
                    <div class="crt-shell" role="search">
                        <span class="flex items-center gap-2.5 shrink-0">
                            <span class="live-dot" aria-hidden="true"></span>
                            <span class="hidden lg:inline">DP-OS 2.026</span>
                        </span>
                        <label class="shell-prompt">
                            <span class="shell-path" aria-hidden="true"><span class="hidden sm:inline">{pathLabel}</span><span class="sm:hidden">C:\</span>&gt;</span>
                            <span class="shell-field">
                                <input
                                    id="shell-input"
                                    type="text"
                                    autocomplete="off"
                                    autocapitalize="off"
                                    spellcheck="false"
                                    enterkeyhint="go"
                                    placeholder=" "
                                    aria-label="Command line. Type help for commands."
                                />
                                <span id="shell-ghost" aria-hidden="true"><span class="ghost-typed"></span><span class="ghost-rest"></span></span>
                            </span>
                        </label>
                        <span class="flex items-center gap-3 shrink-0">
                            <span id="crt-clock" class="hidden md:inline tabular-nums" aria-hidden="true"></span>
                            <button
                                type="button"
                                class="crt-menu-btn"
                                data-cmd="menu"
                            >
                                <kbd>Esc</kbd>menu
                            </button>
                        </span>
                        <span id="scroll-progress" aria-hidden="true"></span>
                    </div>

                    <div
                        id="crt-viewport"
                        tabindex="-1"
                        transition:name="crt-viewport"
                        transition:animate={crtSwitch}
                    >
                        <main id="crt-content">
                            <slot />
                        </main>
                    </div>

                    <button
                        id="to-top"
                        type="button"
                        data-cmd="top"
                        class="icon-rise inline-flex items-center justify-center w-11 h-11 border-2 border-ink dark:border-paper bg-paper dark:bg-ink"
                        aria-label="Back to top"
                    >
                        <span class="material-symbols-outlined text-lg">arrow_upward</span>
                    </button>

                    <div id="crt-boot" aria-hidden="true">
                        <div class="crt-raster">
                            <pre id="crt-post"></pre>
                            <p id="crt-boot-name">Diogo Pires<span class="text-accent">.</span></p>
                            <p id="crt-boot-skip">Click or press any key to skip</p>
                        </div>
                        <div class="crt-beam"></div>
                        <p class="crt-off-hint">Press ⏻ to power on</p>
                    </div>

                    <div class="crt-fx" aria-hidden="true">
                        <span class="crt-glare" id="crt-glare"></span>
                    </div>
                </div>

                <div class="crt-chin">
                    <span class="crt-badge" aria-hidden="true">DP<span class="text-accent">·</span>2026 <span class="crt-badge-note">© Diogo Pires</span></span>
                    <nav class="chin-nav" aria-label="Site">
                        {sections.map((section) => (
                            <a
                                href={section.href}
                                class="chin-btn"
                                data-cmd={section.cmd}
                                aria-label={section.label}
                                aria-current={currentPath === section.href ? "page" : undefined}
                            >
                                {section.n}
                            </a>
                        ))}
                        <button type="button" class="chin-btn" data-cmd="menu" aria-label="Open system menu">
                            menu
                        </button>
                    </nav>
                    <div class="chin-controls">
                        <button
                            id="theme-toggle"
                            type="button"
                            class="chin-btn"
                            data-cmd="theme"
                            aria-label="Toggle color theme"
                        >
                            <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
                        </button>
                        <button
                            id="crt-power"
                            type="button"
                            class="chin-btn"
                            data-cmd="power"
                            aria-label="Turn the screen off"
                            aria-pressed="false"
                        >
                            <span class="material-symbols-outlined" aria-hidden="true">power_settings_new</span>
                        </button>
                        <span id="crt-led" class="crt-led" aria-hidden="true"></span>
                    </div>
                </div>
            </div>

            <div class="keyboard">
                <nav class="kb-row kb-fn" aria-label="Site">
                    <button type="button" class="key key-esc" data-key="escape" data-cmd="menu" aria-label="Open system menu">
                        <small>Esc</small>menu
                    </button>
                    {sections.map((section) => (
                        <a
                            href={section.href}
                            class="key"
                            data-key={`f${section.n}`}
                            data-cmd={section.cmd}
                            aria-current={currentPath === section.href ? "page" : undefined}
                        >
                            <small>F{section.n} <span class="key-cmd">{section.cmd}</span></small>{section.label}
                        </a>
                    ))}
                    <button type="button" class="key" data-key="theme" data-cmd="theme" aria-label="Toggle color theme">
                        <small>◐ <span class="key-cmd">theme</span></small>Theme
                    </button>
                </nav>
                {keyRows.map((row, i) => (
                    <div class:list={["kb-row", i > 0 && "kb-row-extra"]} aria-hidden="true">
                        {row.map((key) => (
                            <span
                                class:list={["key", key.wide && "key-wide", key.space && "key-space"]}
                                data-key={key.code}
                            >
                                {key.label}
                            </span>
                        ))}
                    </div>
                ))}
            </div>
        </div>

        <script is:inline>
            function initMotion() {
                // Reveals that run behind the boot screen are wasted; hold them
                // until the picture is handed over.
                if (document.documentElement.dataset.boot !== undefined) {
                    document.addEventListener("crt:booted", initMotion, { once: true });
                    return;
                }
                var reduced = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;
                var glyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#_";

                var scramble = function (el) {
                    var finalText = (el.dataset.text || el.textContent).trim();
                    el.dataset.text = finalText;
                    if (reduced) return;
                    var frame = 0;
                    clearInterval(el._scrambleTimer);
                    el._scrambleTimer = setInterval(function () {
                        frame += 1.2;
                        el.textContent = finalText
                            .split("")
                            .map(function (c, i) {
                                return c === " " || i < frame
                                    ? c
                                    : glyphs[(Math.random() * glyphs.length) | 0];
                            })
                            .join("");
                        if (frame >= finalText.length) {
                            clearInterval(el._scrambleTimer);
                            el.textContent = finalText;
                        }
                    }, 28);
                };

                var countUp = function (el) {
                    var to = parseFloat(el.dataset.countText);
                    var suffix = el.dataset.suffix || "";
                    // A backgrounded tab freezes rAF, which would leave the
                    // figure stranded at 0. The real value is never worth
                    // trading for an animation nobody is watching.
                    if (reduced || document.hidden) {
                        el.textContent = to + suffix;
                        return;
                    }
                    var start = performance.now() + 200;
                    var tick = function (t) {
                        if (document.hidden) {
                            el.textContent = to + suffix;
                            return;
                        }
                        var p = Math.max(0, Math.min(1, (t - start) / 900));
                        p = 1 - Math.pow(1 - p, 4);
                        el.textContent = Math.round(to * p) + suffix;
                        if (p < 1) requestAnimationFrame(tick);
                    };
                    requestAnimationFrame(tick);
                };

                var onEnter = function (el) {
                    el.classList.add("is-in");
                    if (el.hasAttribute("data-scramble")) scramble(el);
                    el.querySelectorAll("[data-scramble]").forEach(scramble);
                    if (el.hasAttribute("data-count-text")) countUp(el);
                };

                var targets = document.querySelectorAll(
                    "[data-reveal], [data-scramble], [data-count-text]"
                );
                if ("IntersectionObserver" in window && !reduced) {
                    var io = new IntersectionObserver(
                        function (entries) {
                            entries.forEach(function (entry) {
                                if (entry.isIntersecting) {
                                    onEnter(entry.target);
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.2 }
                    );
                    targets.forEach(function (el) {
                        io.observe(el);
                    });
                } else {
                    targets.forEach(onEnter);
                }

                // Collections cascade in rather than appearing all at once.
                // Shared by the highlight grid, the milestone list and the
                // skills table so each page doesn't need its own observer.
                window.__showStagger = function (items, step) {
                    items.forEach(function (item, i) {
                        item.style.setProperty("--stagger", i * (step || 55));
                        item.classList.add("is-shown");
                    });
                };

                document.querySelectorAll("[data-stagger]").forEach(function (group) {
                    var items = Array.prototype.slice.call(
                        group.querySelectorAll(".stagger-item")
                    );
                    if (!items.length) return;
                    var step = parseInt(group.dataset.stagger, 10) || 55;
                    var show = function () {
                        window.__showStagger(items, step);
                    };
                    if ("IntersectionObserver" in window && !reduced) {
                        var gio = new IntersectionObserver(
                            function (entries) {
                                entries.forEach(function (entry) {
                                    if (entry.isIntersecting) {
                                        show();
                                        gio.disconnect();
                                    }
                                });
                            },
                            { threshold: 0.15 }
                        );
                        gio.observe(group);
                    } else {
                        show();
                    }
                });

                var place = function (ink, el, axis) {
                    if (!ink) return;
                    if (!el) {
                        ink.style.setProperty("--o", 0);
                        return;
                    }
                    ink.style.setProperty("--x", el.offsetLeft + "px");
                    ink.style.setProperty("--w", el.offsetWidth + "px");
                    ink.style.setProperty("--o", 1);
                };

                var grid = document.getElementById("highlight-grid");
                var gridInk = document.getElementById("highlight-ink");
                if (grid && gridInk) {
                    var items = grid.querySelectorAll(".highlight-item");
                    items.forEach(function (item) {
                        item.addEventListener("mouseenter", function () {
                            if (window.innerWidth < 768) return;
                            items.forEach(function (x) {
                                x.classList.toggle("is-hot", x === item);
                            });
                            place(gridInk, item);
                            var title = item.querySelector("h3");
                            if (title) scramble(title);
                        });
                    });
                    grid.addEventListener("mouseleave", function () {
                        items.forEach(function (x) {
                            x.classList.remove("is-hot");
                        });
                        place(gridInk, null);
                    });
                }

                if (!reduced && window.matchMedia("(pointer: fine)").matches) {
                    document.querySelectorAll(".magnetic").forEach(function (btn) {
                        // The offset goes into custom properties rather than
                        // onto `transform`, so the :active press scale still
                        // applies to the same element.
                        var dx = 0;
                        var dy = 0;
                        var frame = null;

                        btn.addEventListener("pointermove", function (e) {
                            var cx = e.clientX;
                            var cy = e.clientY;
                            if (frame) return;
                            frame = requestAnimationFrame(function () {
                                frame = null;
                                var r = btn.getBoundingClientRect();
                                // Subtract the offset already applied so the
                                // element can't chase its own transform.
                                var midX = r.left + r.width / 2 - dx;
                                var midY = r.top + r.height / 2 - dy;
                                dx = (cx - midX) * 0.18;
                                dy = (cy - midY) * 0.3;
                                btn.style.setProperty("--mx", dx.toFixed(2) + "px");
                                btn.style.setProperty("--my", dy.toFixed(2) + "px");
                            });
                        });

                        btn.addEventListener("pointerleave", function () {
                            if (frame) {
                                cancelAnimationFrame(frame);
                                frame = null;
                            }
                            dx = 0;
                            dy = 0;
                            btn.style.setProperty("--mx", "0px");
                            btn.style.setProperty("--my", "0px");
                        });
                    });
                }
            }

            // The new theme is revealed from under a still of the old screen,
            // centred on whatever triggered the change.
            window.__toggleTheme = function (origin) {
                var reduced = window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches;
                var root = document.documentElement;
                var wasDark = root.classList.contains("dark");
                var apply = function () {
                    var isDark = root.classList.toggle("dark");
                    try {
                        localStorage.setItem("theme", isDark ? "dark" : "light");
                    } catch (e) {}
                    if (window.syncThemeColorMeta) window.syncThemeColorMeta(isDark);
                };

                var screen = document.getElementById("crt-screen");
                if (reduced || !screen || typeof screen.animate !== "function") {
                    apply();
                    return;
                }

                var old = document.getElementById("theme-wipe");
                if (old) old.remove();

                var box = screen.getBoundingClientRect();
                var x = box.width / 2;
                var y = box.height / 2;
                if (origin && origin.getBoundingClientRect) {
                    var r = origin.getBoundingClientRect();
                    if (r.width) {
                        x = r.left + r.width / 2 - box.left;
                        y = r.top + r.height / 2 - box.top;
                    }
                }

                var wipe = document.createElement("div");
                wipe.id = "theme-wipe";
                wipe.setAttribute("aria-hidden", "true");
                wipe.style.setProperty("--wipe-x", x + "px");
                wipe.style.setProperty("--wipe-y", y + "px");
                wipe.style.setProperty("--wipe-bg", wasDark ? "#0b0d0c" : "#f4f1ea");
                screen.appendChild(wipe);

                // Flip the theme underneath before the circle starts closing.
                apply();
                void wipe.offsetWidth;
                wipe.classList.add("is-wiping");

                var done = false;
                var cleanup = function () {
                    if (done) return;
                    done = true;
                    wipe.remove();
                };
                wipe.addEventListener("animationend", cleanup);
                setTimeout(cleanup, 900);
            };

            document.addEventListener("astro:page-load", initMotion);
        </script>

        <script>
            import { navigate } from "astro:transitions/client";
            import { springValue } from "motion";
            import {
                bindShell,
                clearLog,
                resetShell,
                closeMenu,
                exec,
                register,
                setBlocked,
                toggleMenu,
                visibleCommands,
            } from "../scripts/shell";

            const SECTIONS: Record<string, string> = {
                "1": "cd profile",
                "2": "cd skills",
                "3": "cd projects",
                "4": "cd academic",
                "5": "cd contact",
            };
            const ALIASES: Record<string, string> = {
                "": "/",
                "~": "/",
                "..": "/",
                home: "/",
                menu: "/",
                profile: "/profile",
                skills: "/skills",
                stack: "/skills",
                projects: "/projects",
                work: "/projects",
                academic: "/academic",
                education: "/academic",
                contact: "/contact",
            };
            const LINKS = {
                github: "https://github.com/DiogoPires2003",
                linkedin: "https://www.linkedin.com/in/diogo-filipe-alves-pires-424964245/",
                mail: "mailto:dfalvesp@gmail.com",
            };
            const EASE_OUT = "cubic-bezier(0.23, 1, 0.32, 1)";
            const EASE_IN_OUT = "cubic-bezier(0.77, 0, 0.175, 1)";

            const $ = (id: string) => document.getElementById(id);
            const reduced = () =>
                window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const normalize = (path: string) => path.replace(/\/+$/, "") || "/";

            let booting = false;
            let poweredOff = false;

            function setInert(on: boolean) {
                const viewport = $("crt-viewport");
                if (viewport) viewport.inert = on;
            }

            function setLed(state: "on" | "off" | "busy") {
                const led = $("crt-led");
                if (!led) return;
                led.classList.toggle("is-off", state === "off");
                led.classList.toggle("is-busy", state === "busy");
            }

            function scrollTop() {
                $("crt-viewport")?.scrollTo({
                    top: 0,
                    behavior: reduced() ? "auto" : "smooth",
                });
            }

            function go(path: string) {
                if (normalize(location.pathname) === path) {
                    scrollTop();
                    return;
                }
                navigate(path);
            }

            /* ---------------- Keyboard echo ---------------- */

            function keyName(event: KeyboardEvent) {
                const key = event.key;
                if (/^[1-5]$/.test(key)) return "f" + key;
                if (key === " ") return "space";
                return key.toLowerCase();
            }

            function press(name: string, on: boolean) {
                document
                    .querySelectorAll<HTMLElement>(
                        `.keyboard [data-key="${CSS.escape(name)}"]`
                    )
                    .forEach((key) => {
                        key.classList.toggle("is-pressed", on);
                        clearTimeout((key as any)._release);
                        // A keyup can be lost to a page change or a blur.
                        if (on) {
                            (key as any)._release = setTimeout(
                                () => key.classList.remove("is-pressed"),
                                400
                            );
                        }
                    });
            }

            /* ---------------- Boot and power ---------------- */

            function runBoot() {
                const boot = $("crt-boot");
                const beam = boot?.querySelector<HTMLElement>(".crt-beam");
                const raster = boot?.querySelector<HTMLElement>(".crt-raster");
                const post = $("crt-post");
                const name = $("crt-boot-name");
                const skip = $("crt-boot-skip");
                if (!boot || !beam || !raster || !post || !name || !skip) return;

                booting = true;
                boot.classList.remove("is-off");
                boot.classList.add("is-active");
                boot.style.opacity = "";
                boot.style.pointerEvents = "";
                post.textContent = "";
                name.classList.remove("is-stamped");
                skip.classList.remove("is-armed");
                setInert(true);
                setLed("busy");

                const timers: number[] = [];
                const at = (ms: number, fn: () => void) =>
                    timers.push(window.setTimeout(fn, ms));
                let armed = false;
                let done = false;

                // The gun finds the centre, sweeps a line, then the picture opens.
                beam.animate(
                    [
                        { transform: "scale(0.004, 0.004)", opacity: 0 },
                        { transform: "scale(0.004, 0.004)", opacity: 1, offset: 0.25 },
                        { transform: "scale(1, 0.004)", opacity: 1, offset: 0.7 },
                        { transform: "scale(1, 0.004)", opacity: 0 },
                    ],
                    { duration: 460, easing: EASE_OUT, fill: "both" }
                );
                raster.animate(
                    [
                        { transform: "scale(1, 0.004)", opacity: 0 },
                        { transform: "scale(1.012, 1.02)", opacity: 1, offset: 0.65 },
                        { transform: "none", opacity: 1 },
                    ],
                    { duration: 340, delay: 320, easing: EASE_OUT, fill: "both" }
                );

                // POST: each line is the machine reporting on part of itself.
                const lines: string[] = [];
                const render = () => {
                    post.textContent = lines.join("\n");
                };
                // Lines update in place by index, so a late frame of one test
                // can never write over the line of another.
                const line = (text: string) => {
                    lines.push(text);
                    render();
                    return lines.length - 1;
                };
                const set = (index: number, text: string) => {
                    lines[index] = text;
                    render();
                };

                at(620, () => line("DP-BIOS v2.026   (C) 2003-2026 DIOGO PIRES"));
                at(760, () => line("CPU: CURIOUS-CORE ................... OK"));

                at(900, () => {
                    const row = line("MEMORY TEST: 0K");
                    const start = performance.now();
                    let settled = false;
                    const count = (now: number) => {
                        if (done || settled) return;
                        const p = Math.min(1, (now - start) / 420);
                        const kb = Math.round(16384 * (1 - Math.pow(1 - p, 3)));
                        set(
                            row,
                            p < 1
                                ? `MEMORY TEST: ${kb}K`
                                : "MEMORY TEST: 16384K ................. OK"
                        );
                        if (p < 1) requestAnimationFrame(count);
                    };
                    requestAnimationFrame(count);
                    // rAF stalls in a background tab; the result must still land.
                    at(460, () => {
                        settled = true;
                        set(row, "MEMORY TEST: 16384K ................. OK");
                    });
                });

                // The keyboard on the desk takes part in its own test.
                at(1380, () => {
                    const row = line("KEYBOARD: ");
                    const board = document.querySelector<HTMLElement>(".keyboard");
                    const keys = board?.offsetParent
                        ? Array.from(board.querySelectorAll<HTMLElement>(".key"))
                              .map((key) => ({ key, x: key.getBoundingClientRect().left }))
                              .sort((a, b) => a.x - b.x)
                              .map((entry) => entry.key)
                        : [];
                    // Timers set from here count from this line, not from power-on.
                    keys.forEach((key, i) => {
                        at(i * 9, () => key.classList.add("is-pressed"));
                        at(i * 9 + 110, () => key.classList.remove("is-pressed"));
                    });
                    const sweep = keys.length ? keys.length * 9 + 110 : 120;
                    at(sweep, () =>
                        set(row, `KEYBOARD: ${keys.length || 101} KEYS ................ OK`)
                    );
                });

                // Loading never fills evenly; the stalls are what sell it.
                const BAR = 18;
                const bar = (pct: number) => {
                    const filled = Math.round((pct / 100) * BAR);
                    return `[${"█".repeat(filled)}${"░".repeat(BAR - filled)}] ${String(pct).padStart(3, " ")}%`;
                };
                let barRow = -1;
                at(1820, () => {
                    line("LOADING DIOGO_PIRES.EXE");
                    barRow = line(bar(0));
                });
                [
                    [1880, 9],
                    [1940, 23],
                    [2010, 31],
                    [2130, 38],
                    [2190, 62],
                    [2250, 77],
                    [2330, 84],
                    [2380, 100],
                ].forEach(([ms, pct]) => at(ms, () => set(barRow, bar(pct))));

                at(2440, () => name.classList.add("is-stamped"));
                // A stray click left over from the previous page must not kill
                // the intro before it has said anything.
                at(600, () => {
                    armed = true;
                    skip.classList.add("is-armed");
                });

                const onPointer = () => armed && finish();
                const onKey = (event: KeyboardEvent) => {
                    if (!armed || event.key === "Tab") return;
                    event.preventDefault();
                    finish();
                };
                const onWheel = (event: WheelEvent) =>
                    armed && Math.abs(event.deltaY) > 8 && finish();
                window.addEventListener("pointerdown", onPointer);
                window.addEventListener("keydown", onKey, true);
                window.addEventListener("wheel", onWheel, { passive: true });
                window.addEventListener("touchmove", onPointer, { passive: true });

                function finish() {
                    if (done) return;
                    done = true;
                    timers.forEach(clearTimeout);
                    window.removeEventListener("pointerdown", onPointer);
                    window.removeEventListener("keydown", onKey, true);
                    window.removeEventListener("wheel", onWheel);
                    window.removeEventListener("touchmove", onPointer);
                    setInert(false);
                    setLed("on");
                    document
                        .querySelectorAll(".keyboard .key.is-pressed")
                        .forEach((key) => key.classList.remove("is-pressed"));
                    // Usable the moment the fade starts: the fading layer lets
                    // clicks through and the shell stops refusing commands.
                    booting = false;
                    boot!.style.pointerEvents = "none";
                    // The page's own entrance plays as the picture is handed over.
                    delete document.documentElement.dataset.boot;
                    document.dispatchEvent(new Event("crt:booted"));
                    const fade = boot!.animate([{ opacity: 1 }, { opacity: 0 }], {
                        duration: 200,
                        easing: EASE_OUT,
                        fill: "forwards",
                    });
                    fade.finished
                        .catch(() => {})
                        .then(() => {
                            boot!.classList.remove("is-active");
                            boot!.style.pointerEvents = "";
                            fade.cancel();
                            beam!.getAnimations().forEach((a) => a.cancel());
                            raster!.getAnimations().forEach((a) => a.cancel());
                        });
                }

                at(2950, finish);
            }

            function powerOff() {
                const boot = $("crt-boot");
                const viewport = $("crt-viewport");
                const button = $("crt-power");
                if (!boot || !viewport || booting || poweredOff) return;
                poweredOff = true;
                // Power loss wipes the session: transcript, history, prompt.
                resetShell();
                setInert(true);
                setLed("off");
                button?.setAttribute("aria-pressed", "true");
                button?.setAttribute("aria-label", "Turn the screen on");

                const showOff = () => {
                    boot.classList.add("is-active", "is-off");
                    boot.style.opacity = "";
                };
                if (reduced()) {
                    showOff();
                    return;
                }
                const beam = boot.querySelector<HTMLElement>(".crt-beam");
                viewport
                    .animate(
                        [
                            { transform: "none" },
                            { transform: "scale(1, 0.004)" },
                        ],
                        { duration: 160, easing: EASE_IN_OUT, fill: "forwards" }
                    )
                    .finished.catch(() => {})
                    .then(() => {
                        if (!poweredOff) return;
                        showOff();
                        beam?.animate(
                            [
                                { transform: "scale(1, 0.004)", opacity: 1 },
                                { transform: "scale(0.004, 0.004)", opacity: 1, offset: 0.6 },
                                { transform: "scale(0.004, 0.004)", opacity: 0 },
                            ],
                            { duration: 320, easing: EASE_OUT, fill: "forwards" }
                        );
                    });
            }

            function powerOn() {
                const boot = $("crt-boot");
                const viewport = $("crt-viewport");
                const button = $("crt-power");
                if (!poweredOff) return;
                poweredOff = false;
                // A fresh boot starts with an empty terminal, including the
                // "power" line that just turned it on.
                resetShell();
                button?.setAttribute("aria-pressed", "false");
                button?.setAttribute("aria-label", "Turn the screen off");
                viewport?.getAnimations().forEach((a) => a.cancel());
                boot
                    ?.querySelector<HTMLElement>(".crt-beam")
                    ?.getAnimations()
                    .forEach((a) => a.cancel());
                if (reduced()) {
                    boot?.classList.remove("is-active", "is-off");
                    setInert(false);
                    setLed("on");
                    return;
                }
                runBoot();
            }

            /* ---------------- Glass reflection ---------------- */

            // The reflection trails the pointer on a spring; tied 1:1 to the
            // mouse it reads as a sticker, not as light on glass.
            if (
                window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
                !reduced()
            ) {
                const glareX = springValue(0, { stiffness: 90, damping: 18 });
                const glareY = springValue(0, { stiffness: 90, damping: 18 });
                const render = () => {
                    const glare = $("crt-glare");
                    if (glare) {
                        glare.style.transform = `translate(${glareX.get().toFixed(1)}px, ${glareY.get().toFixed(1)}px)`;
                    }
                };
                glareX.on("change", render);
                glareY.on("change", render);
                window.addEventListener(
                    "pointermove",
                    (event) => {
                        const nx = event.clientX / window.innerWidth - 0.5;
                        const ny = event.clientY / window.innerHeight - 0.5;
                        glareX.set(nx * -120);
                        glareY.set(ny * -80);
                    },
                    { passive: true }
                );
                document.addEventListener("astro:after-swap", render);
            }

            /* ---------------- Clock ---------------- */

            function tickClock() {
                const clock = $("crt-clock");
                if (!clock) return;
                const now = new Date();
                clock.textContent =
                    String(now.getHours()).padStart(2, "0") +
                    ":" +
                    String(now.getMinutes()).padStart(2, "0");
            }
            setInterval(tickClock, 10000);

            /* ---------------- Commands ---------------- */

            function panic(print: (text: string, tone?: "cmd" | "accent") => void) {
                const screen = $("crt-screen");
                print("KERNEL PANIC: attempted to delete the portfolio.", "accent");
                print("…just kidding. Nice try.");
                if (!screen || reduced()) return;
                screen.classList.remove("is-panic");
                void screen.offsetWidth;
                screen.classList.add("is-panic");
                setLed("busy");
                setTimeout(() => {
                    screen.classList.remove("is-panic");
                    setLed("on");
                }, 900);
            }

            setBlocked(() => booting);

            register({
                name: "cd",
                aliases: ["open", "goto"],
                usage: "cd <section>",
                summary: "Go to profile, skills, projects, academic or contact",
                complete: () => ["profile", "skills", "projects", "academic", "contact"],
                run({ args, print }) {
                    const arg = args.join(" ").toLowerCase().replace(/^\/+|\/+$/g, "");
                    const target = ALIASES[arg];
                    if (!target) {
                        print(`cd: no such section: ${arg}`, "accent");
                        return;
                    }
                    if (!poweredOff) go(target);
                },
            });
            register({
                name: "ls",
                aliases: ["dir"],
                summary: "List sections",
                run: ({ print }) => print("profile/   skills/   projects/   academic/   contact/"),
            });
            register({
                name: "whoami",
                summary: "Who is this",
                run({ print }) {
                    print("Diogo Pires: software engineering student & full-stack developer.");
                    print("Universitat de Lleida · intern at IFR Group · Andorra.");
                    print("");
                    print("01 DRIVEN        Pushing boundaries to build scalable, modern web platforms.");
                    print("02 FULL STACK    End-to-end, from low-level systems to web interfaces.");
                    print("03 STUDENT       Academic rigour plus hands-on internship experience.");
                },
            });
            register({
                name: "theme",
                usage: "theme [dark|light]",
                summary: "Switch the screen theme",
                complete: () => ["dark", "light"],
                run({ args, el, print }) {
                    const want = (args[0] || "").toLowerCase();
                    const isDark = document.documentElement.classList.contains("dark");
                    if ((want === "dark" && isDark) || (want === "light" && !isDark)) {
                        print(`Already ${want}.`);
                        return;
                    }
                    (window as any).__toggleTheme?.(el ?? $("theme-toggle"));
                },
            });
            register({
                name: "github",
                summary: "Open GitHub",
                run: () => window.open(LINKS.github, "_blank", "noopener"),
            });
            register({
                name: "linkedin",
                summary: "Open LinkedIn",
                run: () => window.open(LINKS.linkedin, "_blank", "noopener"),
            });
            register({
                name: "mail",
                aliases: ["email"],
                summary: "Write an email",
                run: () => {
                    location.href = LINKS.mail;
                },
            });
            register({
                name: "menu",
                summary: "Go to the start menu, or back from it",
                run: () => {
                    if (!poweredOff) toggleMenu();
                },
            });
            register({
                name: "top",
                summary: "Scroll back to the top",
                hidden: true,
                run: scrollTop,
            });
            register({
                name: "power",
                usage: "power",
                summary: "Turn the screen off or on",
                run: () => (poweredOff ? powerOn() : powerOff()),
            });
            register({
                name: "reboot",
                aliases: ["restart"],
                summary: "Watch the boot sequence again",
                run: () => {
                    if (poweredOff) powerOn();
                    else runBoot();
                },
            });
            register({
                name: "help",
                aliases: ["?"],
                summary: "List commands",
                run({ row }) {
                    visibleCommands().forEach((command) => {
                        const usage = command.usage ?? command.name;
                        // Rows that need an argument fill the prompt instead.
                        row(
                            usage,
                            command.summary,
                            /[<[]/.test(usage) ? { fill: command.name + " " } : { cmd: usage }
                        );
                    });
                },
            });
            register({
                name: "clear",
                aliases: ["cls"],
                summary: "Clear the log",
                run: clearLog,
            });
            register({
                name: "exit",
                aliases: ["quit"],
                summary: "Leave the menu, back to where you were",
                run: () => closeMenu(),
            });
            register({
                name: "date",
                hidden: true,
                summary: "",
                run: ({ print }) => print(new Date().toString()),
            });
            register({
                name: "echo",
                hidden: true,
                summary: "",
                run: ({ args, print }) => print(args.join(" ")),
            });
            register({
                name: "sudo",
                hidden: true,
                summary: "",
                run({ args, print }) {
                    if (args.join(" ").toLowerCase() === "hire diogo") {
                        print("[sudo] password for recruiter: ********");
                        print("Access granted. Opening a channel…", "accent");
                        setTimeout(() => go("/contact"), 900);
                    } else {
                        print("You are not in the sudoers file. This incident will be reported.");
                    }
                },
            });
            register({
                name: "rm",
                hidden: true,
                summary: "",
                run({ args, print }) {
                    if (/-[a-z]*r[a-z]*f|-[a-z]*f[a-z]*r/.test(args.join(" "))) panic(print);
                    else print("rm: permission denied");
                },
            });

            bindShell();

            /* ---------------- Global keys (bound once) ---------------- */

            document.addEventListener(
                "keydown",
                (event) => press(keyName(event), true),
                true
            );
            document.addEventListener("keyup", (event) => press(keyName(event), false));

            document.addEventListener("keydown", (event) => {
                if (booting) return;
                const isK = event.key === "k" || event.key === "K";
                if ((event.metaKey || event.ctrlKey) && isK) {
                    event.preventDefault();
                    exec("menu", { source: "key" });
                    return;
                }
                const target = event.target as HTMLElement | null;
                const typing = !!target?.closest?.("input, textarea, select, [contenteditable]");
                if (typing) return;
                if (event.key === "Escape") {
                    exec("menu", { source: "key" });
                    return;
                }
                if (poweredOff) return;
                if (event.metaKey || event.ctrlKey || event.altKey) return;
                if (event.key === "/") {
                    // Focus the prompt with the slash already typed, so
                    // "/help" reads the way it is written on screen.
                    event.preventDefault();
                    const field = $("shell-input") as HTMLInputElement | null;
                    if (field) {
                        field.value = "/";
                        field.focus();
                        field.dispatchEvent(new Event("input", { bubbles: true }));
                    }
                    return;
                }
                const fn = /^F([1-5])$/.exec(event.key);
                const n = fn ? fn[1] : /^[1-5]$/.test(event.key) ? event.key : null;
                if (n) {
                    event.preventDefault();
                    exec(SECTIONS[n], { source: "key" });
                }
            });

            /* ---------------- Per page ---------------- */

            document.addEventListener("astro:page-load", () => {
                tickClock();

                // A page swap rebuilds the screen, so carry the power state over.
                if (poweredOff) {
                    poweredOff = false;
                    powerOff();
                }

                const viewport = $("crt-viewport");
                const bar = $("scroll-progress");
                const toTop = $("to-top");
                if (viewport) {
                    // scaleX stays on the compositor; width would force layout
                    // on every scroll event.
                    let frame = 0;
                    const update = () => {
                        if (frame) return;
                        frame = requestAnimationFrame(() => {
                            frame = 0;
                            const max = viewport.scrollHeight - viewport.clientHeight;
                            const p = max > 0 ? viewport.scrollTop / max : 0;
                            if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
                            toTop?.classList.toggle(
                                "is-visible",
                                viewport.scrollTop > viewport.clientHeight * 0.9
                            );
                        });
                    };
                    viewport.addEventListener("scroll", update, { passive: true });
                    update();
                }

                if (document.documentElement.dataset.boot !== undefined && !booting) {
                    runBoot();
                }
            });
        </script>
    </body>
</html>
