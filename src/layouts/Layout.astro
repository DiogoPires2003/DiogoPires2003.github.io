---
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Diogo Pires - Software Engineer portfolio.",
} = Astro.props;

const ogImage = new URL("/og-image.jpg", Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const editorialAnim = {
    old: {
        name: "editorial-page-out",
        duration: "160ms",
        easing: "cubic-bezier(0.76, 0, 0.24, 1)",
        fillMode: "both",
    },
    new: {
        name: "editorial-page-in",
        duration: "220ms",
        easing: "cubic-bezier(0.76, 0, 0.24, 1)",
        fillMode: "both",
    },
};
const editorialPageTransition = {
    forwards: editorialAnim,
    backwards: editorialAnim,
};
---

<!DOCTYPE html>
<html lang="en" transition:animate={editorialPageTransition}>
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <ClientRouter />
        <script is:inline>
            function syncThemeColorMeta(isDark) {
                var meta = document.querySelector('meta[name="theme-color"]:not([media])');
                if (!meta) {
                    meta = document.createElement("meta");
                    meta.setAttribute("name", "theme-color");
                    document.head.appendChild(meta);
                }
                meta.setAttribute("content", isDark ? "#0a0a0a" : "#ffffff");
            }

            function applyStoredTheme() {
                var stored = localStorage.getItem("theme");
                var prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)"
                ).matches;
                var isDark = stored ? stored === "dark" : prefersDark;
                document.documentElement.classList.toggle("dark", isDark);
                if (stored) syncThemeColorMeta(isDark);
            }

            applyStoredTheme();

            if (!window.__themeInitBound) {
                window.__themeInitBound = true;
                document.addEventListener("astro:after-swap", applyStoredTheme);
            }
        </script>
        <script
            is:inline
            src="https://cdn.tailwindcss.com?plugins=forms,container-queries"
        ></script>
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
            rel="stylesheet"
        />
        <script is:inline id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            ink: "#0a0a0a",
                            paper: "#ffffff",
                            accent: "#e63946",
                            "accent-dark": "#c1121f",
                        },
                        fontFamily: {
                            sans: ["Archivo", "sans-serif"],
                            mono: ["JetBrains Mono", "monospace"],
                        },
                        borderRadius: {
                            none: "0px",
                            DEFAULT: "0px",
                            lg: "0px",
                            xl: "0px",
                            full: "9999px",
                        },
                        animation: {
                            marquee: "marquee 32s linear infinite",
                        },
                        keyframes: {
                            marquee: {
                                "0%": { transform: "translateX(0%)" },
                                "100%": { transform: "translateX(-50%)" },
                            },
                        },
                    },
                },
            };
        </script>
        <style is:inline>
            html {
                scrollbar-gutter: stable;
                -webkit-tap-highlight-color: transparent;
            }
            ::selection {
                background-color: #e63946;
                color: #ffffff;
            }
            :focus-visible {
                outline: 2px solid #e63946;
                outline-offset: 2px;
            }
            .command-item.is-active {
                background-color: #0a0a0a;
                color: #ffffff;
            }
            :is(.dark) .command-item.is-active {
                background-color: #ffffff;
                color: #0a0a0a;
            }
            #welcome-overlay .welcome-half {
                transition: transform 750ms cubic-bezier(0.65, 0, 0.35, 1);
                position: relative;
                overflow: hidden;
            }
            #welcome-overlay .welcome-tech {
                position: absolute;
                pointer-events: none;
                opacity: 0;
                animation: welcome-tech-float var(--tech-duration, 4400ms) ease-in-out
                    infinite;
                animation-delay: var(--tech-delay, 0ms);
            }
            @keyframes welcome-tech-float {
                0% {
                    opacity: 0;
                    transform: translateY(10px);
                }
                12% {
                    opacity: var(--tech-op, 0.35);
                    transform: translateY(0);
                }
                50% {
                    transform: translateY(-10px);
                }
                88% {
                    opacity: var(--tech-op, 0.35);
                }
                100% {
                    opacity: var(--tech-op, 0.35);
                    transform: translateY(0);
                }
            }
            #welcome-overlay.is-leaving .welcome-half-top {
                transform: translateY(-100%);
            }
            #welcome-overlay.is-leaving .welcome-half-bottom {
                transform: translateY(100%);
            }
            #welcome-overlay .welcome-word {
                display: inline-flex;
                align-items: baseline;
                gap: 0.35em;
                letter-spacing: -0.02em;
                white-space: nowrap;
                font-size: clamp(1.75rem, 7vw, 4rem);
                line-height: 1;
                transition: opacity 250ms ease, transform 250ms ease;
            }
            #welcome-overlay.is-leaving .welcome-word {
                opacity: 0;
                transform: translateY(-6px) scale(0.98);
            }
            #welcome-overlay .welcome-word.is-stamped {
                animation: welcome-stamp 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            .tap-feedback {
                transition: transform 120ms ease-out;
            }
            .tap-feedback:active {
                transform: scale(0.97);
            }
            @media (prefers-reduced-motion: reduce) {
                .tap-feedback {
                    transition: none;
                }
                .tap-feedback:active {
                    transform: none;
                }
            }
            #theme-toggle-icon.is-swapping {
                animation: theme-icon-swap 300ms ease-out;
            }
            @keyframes theme-icon-swap {
                0% {
                    transform: rotate(-45deg) scale(0.6);
                    opacity: 0;
                }
                100% {
                    transform: rotate(0deg) scale(1);
                    opacity: 1;
                }
            }
            @media (prefers-reduced-motion: reduce) {
                #theme-toggle-icon.is-swapping {
                    animation: none;
                }
            }
            .icon-pop {
                animation: icon-pop 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            @keyframes icon-pop {
                0% {
                    transform: scale(0.5);
                    opacity: 0;
                }
                100% {
                    transform: scale(1);
                    opacity: 1;
                }
            }
            @media (prefers-reduced-motion: reduce) {
                .icon-pop {
                    animation: none;
                }
            }
            @keyframes welcome-stamp {
                0% {
                    transform: scale(1.4);
                    opacity: 0;
                }
                55% {
                    transform: scale(0.94);
                    opacity: 1;
                }
                100% {
                    transform: scale(1);
                    opacity: 1;
                }
            }
            .notfound-stamp {
                animation: welcome-stamp 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            @media (prefers-reduced-motion: reduce) {
                .notfound-stamp {
                    animation: none;
                }
            }
            @keyframes editorial-page-out {
                from {
                    opacity: 1;
                    mix-blend-mode: plus-lighter;
                }
                to {
                    opacity: 0;
                    mix-blend-mode: plus-lighter;
                }
            }
            @keyframes editorial-page-in {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                    mix-blend-mode: plus-lighter;
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                    mix-blend-mode: plus-lighter;
                }
            }
        </style>
    </head>
    <body class="bg-paper dark:bg-ink font-sans text-ink dark:text-paper antialiased transition-colors">
        <div
            id="welcome-overlay"
            class="fixed inset-0 z-[200] overflow-hidden"
            aria-hidden="true"
        >
            <div
                class="welcome-half welcome-half-top absolute inset-x-0 top-0 h-1/2 bg-paper dark:bg-ink border-b-2 border-accent"
            >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:8%;top:18%;--tech-op:0.35;--tech-duration:4400ms;--tech-delay:80ms;"
                    >Python</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-accent"
                    style="left:78%;top:14%;--tech-op:0.45;--tech-duration:4000ms;--tech-delay:260ms;"
                    >React</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
                    style="left:16%;top:60%;--tech-op:0.3;--tech-duration:4800ms;--tech-delay:420ms;"
                    >Docker</span
                >
                <span
                    class="welcome-tech font-mono text-[10px] sm:text-xs uppercase tracking-widest text-ink dark:text-paper"
