---
import Layout from "../layouts/Layout.astro";

const links = [
    {
        label: "LinkedIn",
        value: "Diogo Pires",
        href: "https://www.linkedin.com/in/diogo-filipe-alves-pires-424964245/",
        cmd: "linkedin",
    },
    {
        label: "GitHub",
        value: "DiogoPires2003",
        href: "https://github.com/DiogoPires2003",
        cmd: "github",
    },
];
---

<Layout title="Diogo Pires | Contact">
    <section class="screen-page grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-7 flex flex-col min-h-0 border-b-2 lg:border-b-0 lg:border-r-2 border-ink dark:border-paper">
            <div data-reveal class="px-4 sm:px-6 lg:px-10 py-10 sm:py-12 lg:py-6 border-b-2 border-ink dark:border-paper">
                <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-5" data-scramble>
                    [05] Contact
                </p>
                <h1 class="fit-h1 text-4xl sm:text-6xl lg:text-8xl font-black uppercase leading-[0.92] tracking-[-0.035em] mb-5">
                    <span class="reveal-line" style="--i:0"><span>Let&rsquo;s Talk<span class="text-accent stamp-dot">.</span></span></span>
                </h1>
                <p class="reveal-up max-w-xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
                    Have a project, a role, or a question in mind? I&rsquo;d love to
                    hear from you.
                </p>
            </div>

            <div class="flex-1 flex flex-col justify-center">
                <div
                    data-reveal class="reveal-up group flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-4 sm:px-6 lg:px-10 py-5 lg:py-4 border-b border-neutral-300 dark:border-neutral-700 row-invert"
                >
                    <a href="mailto:dfalvesp@gmail.com" data-cmd="mail" class="row-stretch-link flex items-baseline gap-4 min-w-0">
                        <span class="font-mono text-xs text-accent-text shrink-0">/ Email</span>
                        <span class="row-slide text-lg sm:text-2xl font-bold break-all">dfalvesp@gmail.com</span>
                    </a>
                    <button
                        type="button"
                        id="copy-email-btn"
                        data-cmd="copy email"
                        class="row-stretch-over tap-feedback flex items-center gap-2 font-mono text-[11px] tracking-wide opacity-70 hover:opacity-100 shrink-0"
                        aria-label="Copy email address"
                    >
                        <span id="copy-email-label" class="value-swap">copy email</span>
                        <span class="material-symbols-outlined text-xl" id="copy-email-icon">content_copy</span>
                    </button>
                </div>
                {links.map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-cmd={link.cmd}
                        data-reveal class="reveal-up group flex items-center justify-between gap-2 px-4 sm:px-6 lg:px-10 py-5 lg:py-4 border-b border-neutral-300 dark:border-neutral-700 row-invert"
                    >
                        <span class="flex items-baseline gap-4 min-w-0">
                            <span class="font-mono text-xs text-accent-text shrink-0">/ {link.label}</span>
                            <span class="row-slide text-lg sm:text-2xl font-bold truncate">{link.value}</span>
                        </span>
                        <span class="flex items-center gap-3 shrink-0">
                            <span class="hidden sm:inline font-mono text-[11px] opacity-60">{link.cmd}</span>
                            <span class="material-symbols-outlined text-2xl row-arrow">arrow_forward</span>
                        </span>
                    </a>
                ))}
                <p class="px-4 sm:px-6 lg:px-10 py-5 lg:py-4 flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                    <span class="live-dot" aria-hidden="true"></span>
                    Available for internship opportunities
                </p>
            </div>
        </div>

        <div class="lg:col-span-5 flex flex-col items-center justify-center gap-6 px-4 sm:px-6 py-10 lg:py-6 min-h-0">
            <div class="globe-box">
                <canvas
                    id="home-globe"
                    width="560"
                    height="560"
                    style="touch-action: none; -webkit-user-select: none; user-select: none;"
                ></canvas>
            </div>
            <div class="text-center">
                <p class="eyebrow justify-center font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-2" data-scramble>
                    [05.1] Location
                </p>
                <p data-reveal class="text-2xl sm:text-3xl font-black uppercase">
                    Based In Andorra<span class="text-accent stamp-dot">.</span>
                </p>
                <p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mt-2">
                    42.5063&deg; N, 1.5218&deg; E <span class="text-accent-text">/</span> Local time <span id="andorra-time" class="tabular-nums">--:--</span>
                </p>
            </div>
        </div>
    </section>

    <script>
        import { register } from "../scripts/shell";

        document.addEventListener("astro:page-load", () => {
            const copyBtn = document.getElementById("copy-email-btn");
            if (!copyBtn) return;
            const copyLabel = document.getElementById("copy-email-label");
            const copyIcon = document.getElementById("copy-email-icon");
            const EMAIL = "dfalvesp@gmail.com";
            let resetTimer = 0;

            const swap = (text: string) => {
                if (!copyLabel) return;
                copyLabel.classList.add("is-swapping");
                window.setTimeout(() => {
                    copyLabel.textContent = text;
                    copyLabel.classList.remove("is-swapping");
                }, 160);
            };

            register({
                name: "copy",
                usage: "copy email",
                summary: "Copy the email address",
                scope: "page",
                complete: () => ["email"],
                async run({ args, print }) {
                    if (args[0] && args[0].toLowerCase() !== "email") {
                        print(`copy: nothing called ${args[0]}`, "accent");
                        return;
                    }
                    let ok = true;
                    try {
                        await navigator.clipboard.writeText(EMAIL);
                    } catch {
                        ok = false;
                    }
                    swap(ok ? "copied" : "failed");
                    if (copyIcon) {
                        copyIcon.textContent = ok ? "check" : "error";
                        copyIcon.classList.remove("icon-pop");
                        void copyIcon.offsetWidth;
                        copyIcon.classList.add("icon-pop");
                    }
                    window.clearTimeout(resetTimer);
                    resetTimer = window.setTimeout(() => {
                        swap("copy email");
                        if (copyIcon) copyIcon.textContent = "content_copy";
                    }, 1500);
                },
            });

            const time = document.getElementById("andorra-time");
            const format = new Intl.DateTimeFormat("en-GB", {
                hour: "2-digit",
                minute: "2-digit",
                timeZone: "Europe/Andorra",
            });
            const tick = () => {
                if (time) time.textContent = format.format(new Date());
            };
            tick();
            const clock = window.setInterval(tick, 15000);
            document.addEventListener("astro:before-swap", () => window.clearInterval(clock), { once: true });
        });
    </script>

	<script>
		import createGlobe from "cobe";

		let globeInstance;
		let globeRafId;

		function destroyGlobe() {
			if (globeRafId) {
				cancelAnimationFrame(globeRafId);
				globeRafId = null;
			}
			if (globeInstance) {
				globeInstance.destroy();
				globeInstance = null;
			}
		}

		function initGlobe() {
			const canvas = document.getElementById("home-globe");
			if (!canvas) return;
			destroyGlobe();

			const reduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)"
			).matches;
			// Andorra: 42.5063N, 1.5218E — start with it roughly facing the viewer
			let phi = -Math.PI / 2;

			globeInstance = createGlobe(canvas, {
				devicePixelRatio: 2,
				width: 560,
				height: 560,
				phi,
				theta: 0.32,
				dark: 0,
				diffuse: 1.2,
				scale: 1,
				mapSamples: 16000,
				mapBrightness: 6,
				baseColor: [1, 1, 1],
				markerColor: [230 / 255, 57 / 255, 70 / 255],
				glowColor: [1, 1, 1],
				markers: [{ location: [42.5063, 1.5218], size: 0.1 }],
			});

			if (reduced) return;

			// Drag to spin. The pointer offset feeds a velocity that keeps
			// running after release and eases back into the idle drift, so the
			// globe never stops dead against the finger.
			let pointerDown = false;
			let lastX = 0;
			let velocity = 0;
			const IDLE = 0.001;

			canvas.style.cursor = "grab";

			const onDown = (event) => {
				pointerDown = true;
				lastX = event.clientX;
				canvas.style.cursor = "grabbing";
				canvas.setPointerCapture(event.pointerId);
			};
			const onMove = (event) => {
				if (!pointerDown) return;
				const delta = event.clientX - lastX;
				lastX = event.clientX;
				velocity = delta * 0.005;
				phi -= velocity;
			};
			const onUp = (event) => {
				if (!pointerDown) return;
				pointerDown = false;
				canvas.style.cursor = "grab";
				if (canvas.hasPointerCapture?.(event.pointerId)) {
					canvas.releasePointerCapture(event.pointerId);
				}
			};

			canvas.addEventListener("pointerdown", onDown);
			canvas.addEventListener("pointermove", onMove);
			canvas.addEventListener("pointerup", onUp);
			canvas.addEventListener("pointercancel", onUp);

			const animate = () => {
				if (!pointerDown) {
					// Bleed the throw off, then settle back to the idle drift.
					velocity *= 0.95;
					phi += IDLE - velocity;
				}
				globeInstance.update({ phi });
				globeRafId = requestAnimationFrame(animate);
			};
			globeRafId = requestAnimationFrame(animate);
		}

		document.addEventListener("astro:page-load", initGlobe);
		document.addEventListener("astro:before-swap", destroyGlobe);
	</script>
</Layout>
