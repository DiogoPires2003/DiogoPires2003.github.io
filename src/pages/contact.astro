---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Diogo Pires | Contact">
    <section data-reveal class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-20">
        <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-6" data-scramble>
            N&deg; 04 &mdash; Contact
        </p>
        <h1 class="text-4xl sm:text-6xl lg:text-8xl font-black uppercase leading-[0.92] tracking-[-0.035em] mb-6">
            <span class="reveal-line" style="--i:0"><span>Let&rsquo;s Talk<span class="text-accent stamp-dot">.</span></span></span>
        </h1>
        <p class="reveal-up max-w-2xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Have a project, a role, or a question in mind? I&rsquo;d love to
            hear from you.
        </p>
    </section>

    <section class="border-b-2 border-ink dark:border-paper">
        <div
            data-reveal class="reveal-up group flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-4 sm:px-6 lg:px-12 py-8 border-b border-neutral-300 dark:border-neutral-700 row-invert"
        >
            <a href="mailto:dfalvesp@gmail.com" class="row-stretch-link flex items-baseline gap-4 min-w-0">
                <span class="font-mono text-xs text-accent-text">/ Email</span>
                <span class="row-slide text-xl sm:text-2xl font-bold break-all">dfalvesp@gmail.com</span>
            </a>
            <button
                type="button"
                id="copy-email-btn"
                data-email="dfalvesp@gmail.com"
                class="row-stretch-over tap-feedback flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest opacity-70 hover:opacity-100 shrink-0"
                aria-label="Copy email address"
            >
                <span id="copy-email-label" class="value-swap">Copy</span>
                <span class="material-symbols-outlined text-xl" id="copy-email-icon">content_copy</span>
            </button>
        </div>
        <a
            href="https://www.linkedin.com/in/diogo-filipe-alves-pires-424964245/"
            target="_blank"
            rel="noopener noreferrer"
            data-reveal class="reveal-up group flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-4 sm:px-6 lg:px-12 py-8 border-b border-neutral-300 dark:border-neutral-700 row-invert"
        >
            <span class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-accent-text">/ LinkedIn</span>
                <span class="row-slide text-xl sm:text-2xl font-bold">Diogo Pires</span>
            </span>
            <span class="material-symbols-outlined text-2xl row-arrow">
                arrow_forward
            </span>
        </a>
        <a
            href="https://github.com/DiogoPires2003"
            target="_blank"
            rel="noopener noreferrer"
            data-reveal class="reveal-up group flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-4 sm:px-6 lg:px-12 py-8 row-invert"
        >
            <span class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-accent-text">/ GitHub</span>
                <span class="row-slide text-xl sm:text-2xl font-bold">DiogoPires2003</span>
            </span>
            <span class="material-symbols-outlined text-2xl row-arrow">
                arrow_forward
            </span>
        </a>
    </section>

    <section class="px-4 sm:px-6 lg:px-12 py-6 flex items-center gap-3">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="font-mono text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
            Available for internship opportunities
        </span>
    </section>

    <script is:inline>
        document.addEventListener("astro:page-load", () => {
            const copyBtn = document.getElementById("copy-email-btn");
            const copyLabel = document.getElementById("copy-email-label");
            const copyIcon = document.getElementById("copy-email-icon");
            let resetTimer;

            copyBtn?.addEventListener("click", async (event) => {
                event.preventDefault();
                const email = copyBtn.dataset.email || "";

                const swap = (text) => {
                    if (!copyLabel) return;
                    copyLabel.classList.add("is-swapping");
                    window.setTimeout(() => {
                        copyLabel.textContent = text;
                        copyLabel.classList.remove("is-swapping");
                    }, 160);
                };
                try {
                    await navigator.clipboard.writeText(email);
                    swap("Copied");
                    if (copyIcon) copyIcon.textContent = "check";
                } catch (err) {
                    swap("Failed");
                }
                if (copyIcon) {
                    copyIcon.classList.remove("icon-pop");
                    void copyIcon.offsetWidth;
                    copyIcon.classList.add("icon-pop");
                }
                clearTimeout(resetTimer);
                resetTimer = setTimeout(() => {
                    swap("Copy");
                    if (copyIcon) copyIcon.textContent = "content_copy";
                }, 1500);
            });
        });
    </script>
</Layout>
