---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Diogo Pires | Contact">
    <section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-20">
        <p class="font-mono text-xs text-accent uppercase tracking-[0.25em] mb-6">
            N&deg; 04 &mdash; Contact
        </p>
        <h1 class="text-4xl sm:text-6xl lg:text-8xl font-black uppercase leading-[0.92] tracking-tight mb-6">
            Let&rsquo;s Talk<span class="text-accent">.</span>
        </h1>
        <p class="max-w-2xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Have a project, a role, or a question in mind? I&rsquo;d love to
            hear from you.
        </p>
    </section>

    <section class="border-b-2 border-ink dark:border-paper">
        <div
            class="group flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-4 sm:px-6 lg:px-12 py-8 border-b border-neutral-300 dark:border-neutral-700 hover:bg-ink hover:text-paper dark:hover:bg-paper dark:hover:text-ink transition-colors"
        >
            <a href="mailto:dfalvesp@gmail.com" class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-accent">/ Email</span>
                <span class="text-xl sm:text-2xl font-bold break-all">dfalvesp@gmail.com</span>
            </a>
            <button
                type="button"
                id="copy-email-btn"
                data-email="dfalvesp@gmail.com"
                class="tap-feedback flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest opacity-70 hover:opacity-100 transition-opacity shrink-0"
                aria-label="Copy email address"
            >
                <span id="copy-email-label">Copy</span>
                <span class="material-symbols-outlined text-xl" id="copy-email-icon">content_copy</span>
            </button>
        </div>
        <a
            href="https://www.linkedin.com/in/diogo-filipe-alves-pires-424964245/"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-4 sm:px-6 lg:px-12 py-8 border-b border-neutral-300 dark:border-neutral-700 hover:bg-ink hover:text-paper dark:hover:bg-paper dark:hover:text-ink transition-colors"
        >
            <span class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-accent">/ LinkedIn</span>
                <span class="text-xl sm:text-2xl font-bold">Diogo Pires</span>
            </span>
            <span class="material-symbols-outlined text-2xl group-hover:translate-x-1 transition-transform">
                arrow_forward
            </span>
        </a>
        <a
            href="https://github.com/DiogoPires2003"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-4 sm:px-6 lg:px-12 py-8 hover:bg-ink hover:text-paper dark:hover:bg-paper dark:hover:text-ink transition-colors"
        >
            <span class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-accent">/ GitHub</span>
                <span class="text-xl sm:text-2xl font-bold">DiogoPires2003</span>
            </span>
            <span class="material-symbols-outlined text-2xl group-hover:translate-x-1 transition-transform">
                arrow_forward
            </span>
        </a>
    </section>

    <section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-10 flex flex-col sm:flex-row items-center gap-8">
        <div
            class="shrink-0 border-2 border-ink dark:border-paper rounded-full overflow-hidden"
            style="width: 180px; height: 180px;"
        >
            <canvas
                id="contact-globe"
                width="360"
                height="360"
                style="width: 180px; height: 180px; display: block;"
            ></canvas>
        </div>
        <div class="text-center sm:text-left">
            <p class="font-mono text-xs text-accent uppercase tracking-[0.25em] mb-2">
                / Based In
            </p>
            <p class="text-2xl sm:text-3xl font-black uppercase">
                Andorra<span class="text-accent">.</span>
            </p>
            <p class="font-mono text-xs text-neutral-500 mt-1">
                42.5063&deg; N, 1.5218&deg; E
            </p>
        </div>
    </section>

    <section class="px-4 sm:px-6 lg:px-12 py-6 flex items-center gap-3">
        <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full bg-accent opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 bg-accent"></span>
        </span>
        <span class="font-mono text-xs uppercase tracking-widest text-neutral-500">
            Available for internship opportunities
        </span>
    </section>

    <script>
        import createGlobe from "cobe";

        let globeInstance;

        function destroyGlobe() {
            if (globeInstance) {
                globeInstance.destroy();
                globeInstance = null;
            }
        }

        function initGlobe() {
            const canvas = document.getElementById("contact-globe");
            if (!canvas) return;
            destroyGlobe();

            const reduced = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;
            let phi = 0;

            globeInstance = createGlobe(canvas, {
                devicePixelRatio: 2,
                width: 360,
                height: 360,
                phi: 0,
                theta: 0.3,
                dark: 0,
                diffuse: 1.2,
                scale: 1,
                mapSamples: 16000,
                mapBrightness: 6,
                baseColor: [0.06, 0.06, 0.06],
                markerColor: [230 / 255, 57 / 255, 70 / 255],
                glowColor: [0.7, 0.7, 0.7],
                markers: [{ location: [42.5063, 1.5218], size: 0.12 }],
                onRender: (state) => {
                    if (!reduced) {
                        phi += 0.0035;
                    }
                    state.phi = phi;
                },
            });
        }

        document.addEventListener("astro:page-load", initGlobe);
        document.addEventListener("astro:before-swap", destroyGlobe);
    </script>

    <script is:inline>
        document.addEventListener("astro:page-load", () => {
            const copyBtn = document.getElementById("copy-email-btn");
            const copyLabel = document.getElementById("copy-email-label");
            const copyIcon = document.getElementById("copy-email-icon");
            let resetTimer;

            copyBtn?.addEventListener("click", async (event) => {
                event.preventDefault();
                const email = copyBtn.dataset.email || "";
                try {
                    await navigator.clipboard.writeText(email);
                    if (copyLabel) copyLabel.textContent = "Copied";
                    if (copyIcon) copyIcon.textContent = "check";
                } catch (err) {
                    if (copyLabel) copyLabel.textContent = "Failed";
                }
                if (copyIcon) {
                    copyIcon.classList.remove("icon-pop");
                    void copyIcon.offsetWidth;
                    copyIcon.classList.add("icon-pop");
                }
                clearTimeout(resetTimer);
                resetTimer = setTimeout(() => {
                    if (copyLabel) copyLabel.textContent = "Copy";
                    if (copyIcon) copyIcon.textContent = "content_copy";
                }, 1500);
            });
        });
    </script>
</Layout>
