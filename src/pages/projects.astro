---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Diogo Pires | Projects">
    <section class="screen-page grid grid-cols-1 lg:grid-cols-12">
        <div
            data-reveal
            class="lg:col-span-7 flex flex-col justify-center px-4 sm:px-6 lg:px-12 py-14 sm:py-16 lg:py-8 border-b-2 lg:border-b-0 lg:border-r-2 border-ink dark:border-paper"
        >
            <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-6" data-scramble>
                [03] Projects
            </p>
            <h1 class="fit-h1 text-5xl sm:text-7xl lg:text-8xl font-black uppercase leading-[0.92] tracking-[-0.035em] mb-6">
                <span class="reveal-line" style="--i:0"><span>Coming</span></span>
                <span class="reveal-line" style="--i:1"><span>Soon<span class="text-accent stamp-dot">.</span></span></span>
            </h1>
            <p class="reveal-up max-w-xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-8">
                Write-ups of the things I have built are on their way. Until
                then, the code speaks for itself on GitHub.
            </p>
            <div class="reveal-up flex flex-wrap" style="--i:2">
                <a
                    href="https://github.com/DiogoPires2003"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cmd="github"
                    class="tap-feedback btn-sweep btn-primary magnetic group px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-ink dark:border-paper flex items-center gap-2"
                >
                    Browse GitHub
                    <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </a>
                <a
                    href="/skills"
                    data-cmd="cd skills"
                    class="tap-feedback btn-sweep magnetic px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-l-0 border-ink dark:border-paper flex items-center"
                >
                    View Stack
                </a>
            </div>
        </div>

        <div class="lg:col-span-5 flex flex-col justify-center gap-3 px-4 sm:px-6 lg:px-10 py-10 lg:py-8 font-mono text-xs sm:text-sm">
            <p class="opacity-60">C:\DIOGO&gt; build projects</p>
            <p>Compiling case studies…</p>
            <p class="flex items-center gap-3">
                <span class="seg-bar seg-bar-lg w-48 sm:w-60 text-accent" aria-hidden="true">
                    <span class="skill-bar-fill" style="transform: scaleX(0.4);"></span>
                </span>
                <span class="tabular-nums">40%</span>
            </p>
            <p class="text-neutral-500 dark:text-neutral-400">ETA: soon<span class="text-accent-text">.</span></p>
        </div>
    </section>
</Layout>
