---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import hexterraShot from "../assets/hexterra-preview.jpg";

const SOURCE = "https://github.com/DiogoPires2003/DiogoPires2003.github.io/tree/main/src/hexterra";

const facts = [
    { label: "Type", value: "3D strategy game" },
    { label: "Players", value: "1–4 · online rooms" },
    { label: "Stack", value: "Three.js · TypeScript" },
    { label: "Status", value: "Playable" },
];

const tags = ["Three.js", "TypeScript", "WebRTC", "Web Audio", "Vitest", "Astro"];
---

<Layout title="Diogo Pires | Projects" description="Projects by Diogo Pires, starting with Hexterra, a 3D turn-based strategy game in the browser.">
    <section class="screen-page grid grid-cols-1 lg:grid-cols-12">
        <div
            data-reveal
            class="lg:col-span-7 flex flex-col justify-center px-4 sm:px-6 lg:px-12 py-14 sm:py-16 lg:py-8 border-b-2 lg:border-b-0 lg:border-r-2 border-ink dark:border-paper"
        >
            <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-6" data-scramble>
                [03] Projects · 01
            </p>
            <h1 class="fit-h1 text-5xl sm:text-7xl lg:text-8xl font-black uppercase leading-[0.92] tracking-[-0.035em] mb-6">
                <span class="reveal-line" style="--i:0"><span>Hexterra<span class="text-accent stamp-dot">.</span></span></span>
            </h1>
            <p class="reveal-up max-w-xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
                A turn-based strategy game in the browser, in the spirit of the
                classic hex-colonisation board games. Corporations race to settle
                a freshly terraformed island at dusk: roll for resources, trade,
                lay conduits, found colonies and raise towers until someone
                reaches ten points.
            </p>
            <p class="reveal-up max-w-xl text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6" style="--i:1">
                A tested rules engine with bots, online rooms by code over
                peer-to-peer WebRTC, physically based rendering with a reflective
                ocean, a guided tutorial and a generative soundtrack synthesised
                in Web Audio. No backend: it ships as static files on this site.
            </p>
            <ul class="reveal-up flex flex-wrap gap-2 mb-8 font-mono text-[11px] uppercase tracking-widest" style="--i:2" aria-label="Built with">
                {tags.map((t) => <li class="px-2.5 py-1 border border-neutral-400 dark:border-neutral-600">{t}</li>)}
            </ul>
            <div class="reveal-up flex flex-wrap" style="--i:3">
                <a
                    href="/hexterra/"
                    data-cmd="hexterra"
                    data-astro-reload
                    class="tap-feedback btn-sweep btn-primary magnetic group px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-ink dark:border-paper flex items-center gap-2"
                >
                    Play Hexterra
                    <span class="material-symbols-outlined text-lg">sports_esports</span>
                </a>
                <a
                    href={SOURCE}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tap-feedback btn-sweep magnetic px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-l-0 border-ink dark:border-paper flex items-center gap-2"
                >
                    Source
                    <span class="material-symbols-outlined text-lg">arrow_outward</span>
                </a>
            </div>
        </div>

        <div class="lg:col-span-5 flex flex-col min-h-0">
            <a
                href="/hexterra/"
                data-cmd="hexterra"
                data-astro-reload
                class="project-shot group relative block aspect-[16/10] lg:aspect-auto lg:flex-1 lg:min-h-0 overflow-hidden border-b-2 border-ink dark:border-paper"
                aria-label="Play Hexterra"
            >
                <Image
                    src={hexterraShot}
                    alt="Hexterra: an island of hexagonal sectors at dusk with colonies, conduits, a glass tower and trade stations on the coast."
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    loading="eager"
                    decoding="async"
                    class="absolute inset-0 w-full h-full object-cover object-[50%_45%] transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />
                <span class="absolute left-3 bottom-3 font-mono text-[11px] uppercase tracking-widest px-2 py-1 bg-ink text-paper dark:bg-paper dark:text-ink">
                    C:\DIOGO&gt; hexterra
                </span>
            </a>
            <dl class="font-mono text-xs">
                {facts.map((fact, i) => (
                    <div
                        class:list={[
                            "flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:justify-between px-4 sm:px-6 py-3.5",
                            i !== facts.length - 1 && "border-b border-neutral-300 dark:border-neutral-700",
                        ]}
                    >
                        <dt class="uppercase text-neutral-500 dark:text-neutral-400 tracking-widest shrink-0">{fact.label}</dt>
                        <dd
                            class:list={[
                                "font-bold uppercase truncate max-w-full sm:text-right sm:max-w-[65%]",
                                fact.label === "Status" && "text-accent-text",
                            ]}
                        >{fact.label === "Status" && <span class="live-dot live-dot-inline" aria-hidden="true"></span>}{fact.value}</dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>
</Layout>
