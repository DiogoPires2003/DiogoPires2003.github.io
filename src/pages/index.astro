						>asterisk</span
					>
					POSTGRESQL <span
						class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					MY SQL <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					DOCKER <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					BASH SCRIPTING <span
						class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					THREE.JS <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
				</span>
			</div>
			<div class="flex items-center pr-4" aria-hidden="true">
				<span
					class="text-white text-base sm:text-xl font-black uppercase italic tracking-widest flex items-center gap-3 sm:gap-4"
				>
					PYTHON <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					JAVA <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					JAVASCRIPT <span
						class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					TYPESCRIPT <span
						class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					C <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					ASSEMBLY <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					DJANGO <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					REACT <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					SOLID JS <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					ASTRO <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					SCALA <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					HTML <span class="material-symbols-outlined text-accent"
						>asterisk</span
					>
					CSS <span class="material-symbols-outlined text-accent"
