---
import Layout from "../layouts/Layout.astro";

const sections = [
    { n: "1", label: "profile", href: "/profile", cmd: "cd profile", desc: "Who I am, at a glance" },
    { n: "2", label: "skills", href: "/skills", cmd: "cd skills", desc: "Languages, frameworks, tools" },
    { n: "3", label: "projects", href: "/projects", cmd: "cd projects", desc: "Coming soon" },
    { n: "4", label: "academic", href: "/academic", cmd: "cd academic", desc: "Education and milestones" },
    { n: "5", label: "contact", href: "/contact", cmd: "cd contact", desc: "Email, LinkedIn, GitHub" },
];
---

<Layout title="Diogo Pires | Software Engineer">
    <section id="crt-menu" class="screen-page" aria-label="Start menu">
        <div class="bios-head">
            <span>DP-OS · Start</span>
            <span class="hidden sm:inline">v2.026</span>
        </div>
        <div class="bios-body">
            <p class="term-comment"># Diogo Pires, software engineer. Pick a section, or type a command.</p>
            <p class="term-prompt" aria-hidden="true">C:\DIOGO&gt; ls</p>
            <nav class="term-block" aria-label="Sections">
                {sections.map((section) => (
                    <a href={section.href} class="bios-item term-row" data-cmd={section.cmd}>
                        <span class="term-caret" aria-hidden="true">&gt;</span>
                        <span class="term-name">{section.label}/</span>
                        <span class="term-desc">{section.desc}</span>
                        <span class="term-key" aria-hidden="true">[{section.n}]</span>
                    </a>
                ))}
            </nav>
            <p class="term-tip">
                Type <button type="button" class="term-inline" data-cmd="/help">/help</button> to see other commands.
            </p>
            <p class="term-comment term-keys"># ↑↓ select · enter open · 1-5 jump · tab completes · esc goes back</p>
            <div id="crt-log" aria-live="polite"></div>
        </div>
    </section>
</Layout>
