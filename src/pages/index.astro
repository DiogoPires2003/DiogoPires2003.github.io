---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";

const stack = [
	"Python", "Java", "JavaScript", "TypeScript", "C", "Assembly", "Django",
	"React", "Solid JS", "Astro", "Scala", "HTML", "CSS", "Arduino",
	"PostgreSQL", "MySQL", "Docker", "Bash", "Three.js",
];

const facts = [
	{ label: "Status", value: "Available" },
	{ label: "Focus", value: "Full-Stack" },
	{ label: "Based", value: "Andorra" },
	{ label: "Latest Updated Repo", value: "—", id: "gh-latest" },
];

const highlights = [
	{
		n: "01",
		title: "Driven",
		text: "Constantly pushing boundaries to build scalable and modern web platforms.",
	},
	{
		n: "02",
		title: "Full Stack",
		text: "End-to-end architecture, from low-level systems to modern web interfaces.",
	},
	{
		n: "03",
		title: "Student & Intern",
		text: "Combining academic rigor with hands-on internship experience.",
	},
];
---

<Layout title="Diogo Pires | Home">
	<section class="border-b-2 border-ink dark:border-paper">
		<div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12">
			<div
				class="lg:col-span-8 px-4 sm:px-6 lg:px-12 py-16 sm:py-20 lg:py-28 border-b-2 lg:border-b-0 lg:border-r-2 border-ink dark:border-paper"
			>
				<p class="font-mono text-xs text-accent uppercase tracking-[0.25em] mb-6">
					N&deg; 01 &mdash; Introduction
				</p>
				<h1
					class="text-5xl sm:text-7xl lg:text-8xl font-black uppercase leading-[0.92] tracking-tight mb-8"
				>
					Software<br />
					Engineer<span class="text-accent">.</span>
				</h1>
				<p
					class="max-w-xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 mb-10 leading-relaxed"
				>
					Computer Science student and full-stack developer
					engineering efficient, scalable systems. Combining academic
					knowledge with hands-on internship experience to build
					high-performance data pipelines and modern web platforms.
				</p>
				<div class="flex flex-wrap">
					<a
						href="/skills"
						class="tap-feedback group px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-ink dark:border-paper bg-ink text-paper dark:bg-paper dark:text-ink hover:bg-paper hover:text-ink dark:hover:bg-ink dark:hover:text-paper transition-colors flex items-center gap-2"
					>
						View Stack
						<span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
					</a>
					<a
						href="/contact"
						class="tap-feedback px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-l-0 border-ink dark:border-paper hover:bg-ink hover:text-paper dark:hover:bg-paper dark:hover:text-ink transition-colors flex items-center"
					>
						Contact
					</a>
				</div>
			</div>

			<div class="lg:col-span-4 flex flex-col">
				<div class="aspect-[4/5] overflow-hidden border-b-2 border-ink dark:border-paper">
					<Image
						src={profileImage}
						alt="Diogo Pires"
						sizes="(min-width: 1024px) 28rem, 100vw"
						loading="eager"
						decoding="async"
						class="w-full h-full object-cover grayscale hover:grayscale-0 hover:scale-105 transition-all duration-500 bg-neutral-200 dark:bg-neutral-900"
					/>
				</div>
				<dl class="font-mono text-xs flex-1">
					{facts.map((fact, i) => (
						<div
							class:list={[
								"flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:justify-between px-4 sm:px-6 py-5",
								i !== facts.length - 1 && "border-b border-neutral-300 dark:border-neutral-700",
							]}
						>
							<dt class="uppercase text-neutral-500 tracking-widest shrink-0">{fact.label}</dt>
							<dd
								id={fact.id}
								class:list={[
									"font-bold uppercase truncate max-w-full sm:text-right sm:max-w-[65%] transition-opacity duration-200 ease-out motion-reduce:transition-none",
									fact.label === "Status" && "text-accent",
								]}
							>{fact.value}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-16">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 max-w-5xl">
			<p class="lg:col-span-3 font-mono text-xs text-accent uppercase tracking-[0.25em]">
				N&deg; 01.1 &mdash; Profile
			</p>
			<p class="lg:col-span-9 text-lg sm:text-xl leading-relaxed text-neutral-700 dark:text-neutral-300">
				I'm a Software Engineering student at Universitat de Lleida,
				currently applying what I learn as an intern at IFR Group. My
				focus spans the full stack &mdash; from low-level C and
				Assembly to modern frameworks like Django, React and Astro
				&mdash; and I like moving fast: a 24-hour hackathon win and
				20+ academic projects along the way. Outside of coursework,
				I'm drawn to embedded systems and 3D web graphics.
			</p>
		</div>
	</section>

	<section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-10 flex flex-col sm:flex-row items-center gap-8">
		<div
			class="shrink-0 border-2 border-ink dark:border-paper rounded-full overflow-hidden bg-ink"
			style="width: 180px; height: 180px;"
		>
			<canvas
				id="home-globe"
				width="360"
				height="360"
				style="width: 180px; height: 180px; display: block;"
			></canvas>
		</div>
		<div class="text-center sm:text-left">
			<p class="font-mono text-xs text-accent uppercase tracking-[0.25em] mb-2">
				N&deg; 01.2 &mdash; Location
			</p>
			<p class="text-2xl sm:text-3xl font-black uppercase">
				Based In Andorra<span class="text-accent">.</span>
			</p>
			<p class="font-mono text-xs text-neutral-500 mt-1">
				42.5063&deg; N, 1.5218&deg; E
			</p>
		</div>
	</section>

	<section class="grid grid-cols-1 md:grid-cols-3 border-b-2 border-ink dark:border-paper">
		{highlights.map((item, i) => (
			<div
				class:list={[
					"highlight-item p-8 sm:p-10 opacity-0 translate-y-2 transition-[opacity,transform] duration-500 ease-out motion-reduce:transition-none motion-reduce:duration-0",
					i !== highlights.length - 1 && "border-b-2 md:border-b-0 md:border-r-2 border-ink dark:border-paper",
				]}
			>
				<span class="font-mono text-xs text-accent">{item.n}</span>
				<h3 class="text-2xl font-black uppercase mt-3 mb-3">{item.title}</h3>
				<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
					{item.text}
				</p>
			</div>
		))}
	</section>

	<section class="bg-ink text-paper dark:bg-paper dark:text-ink py-4 overflow-hidden whitespace-nowrap">
		<div class="flex w-max animate-marquee font-mono text-sm uppercase tracking-widest">
			<div class="flex items-center pr-6">
				{stack.map((tech) => (
					<>
						{tech}
						<span class="text-accent mx-6">/</span>
					</>
				))}
			</div>
			<div class="flex items-center pr-6" aria-hidden="true">
				{stack.map((tech) => (
					<>
						{tech}
						<span class="text-accent mx-6">/</span>
					</>
				))}
			</div>
		</div>
	</section>

	<script is:inline>
		document.addEventListener("astro:page-load", () => {
			const el = document.getElementById("gh-latest");
			if (!el || el.dataset.loaded) return;
			el.dataset.loaded = "pending";

			const timeAgo = (date) => {
				const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
				const intervals = [
					["y", 31536000],
					["mo", 2592000],
					["d", 86400],
					["h", 3600],
					["m", 60],
				];
				for (const [label, secs] of intervals) {
					const count = Math.floor(seconds / secs);
					if (count >= 1) return `${count}${label} ago`;
				}
				return "just now";
			};

			const setValue = (text, title) => {
				el.style.opacity = "0";
				window.setTimeout(() => {
					el.textContent = text;
					if (title) el.title = title;
					el.style.opacity = "1";
				}, 150);
			};

			fetch(
				"https://api.github.com/users/DiogoPires2003/repos?sort=pushed&direction=desc&per_page=1"
			)
				.then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
				.then((repos) => {
					const repo = repos[0];
					if (!repo) {
						setValue("No activity");
						return;
					}
					setValue(
						`${repo.name} · ${timeAgo(new Date(repo.pushed_at))}`,
						`Last push to ${repo.full_name}`
					);
				})
				.catch(() => {
					setValue("Unavailable");
				});

			const highlightItems = document.querySelectorAll(".highlight-item");
			if (highlightItems.length) {
				const reveal = (el) => el.classList.remove("opacity-0", "translate-y-2");
				if ("IntersectionObserver" in window) {
					const highlightObserver = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									reveal(entry.target);
									highlightObserver.unobserve(entry.target);
								}
							});
						},
						{ threshold: 0.15 }
					);
					highlightItems.forEach((item) => highlightObserver.observe(item));
				} else {
					highlightItems.forEach(reveal);
				}
			}
		});
	</script>

	<script>
		import createGlobe from "cobe";

		let globeInstance;
		let globeRafId;

		function destroyGlobe() {
			if (globeRafId) {
				cancelAnimationFrame(globeRafId);
				globeRafId = null;
			}
			if (globeInstance) {
				globeInstance.destroy();
				globeInstance = null;
			}
		}

		function initGlobe() {
			const canvas = document.getElementById("home-globe");
			if (!canvas) return;
			destroyGlobe();

			const reduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)"
			).matches;
			// Andorra: 42.5063N, 1.5218E — start with it roughly facing the viewer
			let phi = -Math.PI / 2;

			globeInstance = createGlobe(canvas, {
				devicePixelRatio: 2,
				width: 360,
				height: 360,
				phi,
				theta: 0.32,
				dark: 0,
				diffuse: 1.2,
				scale: 1,
				mapSamples: 16000,
				mapBrightness: 6,
				baseColor: [1, 1, 1],
				markerColor: [230 / 255, 57 / 255, 70 / 255],
				glowColor: [1, 1, 1],
				markers: [{ location: [42.5063, 1.5218], size: 0.1 }],
			});

			if (reduced) return;

			const animate = () => {
				phi += 0.001;
				globeInstance.update({ phi });
				globeRafId = requestAnimationFrame(animate);
			};
			globeRafId = requestAnimationFrame(animate);
		}

		document.addEventListener("astro:page-load", initGlobe);
		document.addEventListener("astro:before-swap", destroyGlobe);
	</script>
</Layout>
