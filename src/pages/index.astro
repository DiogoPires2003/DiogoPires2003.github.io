---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";

const stack = [
	"Python", "Java", "JavaScript", "TypeScript", "C", "Assembly", "Django",
	"React", "Solid JS", "Astro", "Scala", "HTML", "CSS", "Arduino",
	"PostgreSQL", "MySQL", "Docker", "Bash", "Three.js",
];

const words = ["Driven", "Curious", "Relentless", "Full Stack", "Based in Andorra", "Driven", "Curious", "Relentless", "Full Stack", "Based in Andorra"];

const facts = [
	{ label: "Status", value: "Available" },
	{ label: "Focus", value: "Full-Stack" },
	{ label: "Based", value: "Andorra" },
	{ label: "Latest Updated Repo", value: "—", id: "gh-latest" },
];

const highlights = [
	{
		n: "01",
		title: "Driven",
		text: "Constantly pushing boundaries to build scalable and modern web platforms.",
	},
	{
		n: "02",
		title: "Full Stack",
		text: "End-to-end architecture, from low-level systems to modern web interfaces.",
	},
	{
		n: "03",
		title: "Student & Intern",
		text: "Combining academic rigor with hands-on internship experience.",
	},
];
---

<Layout title="Diogo Pires | Home">
	<section class="border-b-2 border-ink dark:border-paper">
		<div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12">
			<div
				data-reveal
				class="lg:col-span-8 px-4 sm:px-6 lg:px-12 py-16 sm:py-20 lg:py-28 border-b-2 lg:border-b-0 lg:border-r-2 border-ink dark:border-paper"
			>
				<p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-6" data-scramble>
					N&deg; 01 &mdash; Introduction
				</p>
				<h1
					class="text-5xl sm:text-7xl lg:text-8xl font-black uppercase leading-[0.92] tracking-[-0.035em] mb-8"
				>
					<span class="reveal-line" style="--i:0"><span>Software</span></span>
					<span class="reveal-line" style="--i:1"><span>Engineer<span class="text-accent stamp-dot">.</span></span></span>
				</h1>
				<p
					class="reveal-up max-w-xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 mb-10 leading-relaxed"
				>
					Computer Science student and full-stack developer
					engineering efficient, scalable systems. Combining academic
					knowledge with hands-on internship experience to build
					high-performance data pipelines and modern web platforms.
				</p>
				<div class="reveal-up flex flex-wrap" style="--i:2">
					<a
						href="/skills"
						class="tap-feedback btn-sweep btn-primary magnetic group px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-ink dark:border-paper flex items-center gap-2"
					>
						View Stack
						<span class="material-symbols-outlined text-lg">arrow_forward</span>
					</a>
					<a
						href="/contact"
						class="tap-feedback btn-sweep magnetic px-7 sm:px-9 py-4 text-xs sm:text-sm font-bold uppercase tracking-wide border-2 border-l-0 border-ink dark:border-paper flex items-center"
					>
						Contact
					</a>
				</div>
			</div>

			<div class="lg:col-span-4 flex flex-col">
				<div class="aspect-[4/5] overflow-hidden border-b-2 border-ink dark:border-paper">
					<Image
						src={profileImage}
						alt="Diogo Pires"
						sizes="(min-width: 1024px) 28rem, 100vw"
						loading="eager"
						decoding="async"
						class="profile-shot w-full h-full object-cover grayscale bg-neutral-200 dark:bg-neutral-900"
					/>
				</div>
				<dl class="font-mono text-xs flex-1">
					{facts.map((fact, i) => (
						<div
							class:list={[
								"flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:justify-between px-4 sm:px-6 py-5",
								i !== facts.length - 1 && "border-b border-neutral-300 dark:border-neutral-700",
							]}
						>
							<dt class="uppercase text-neutral-500 dark:text-neutral-400 tracking-widest shrink-0">{fact.label}</dt>
							<dd
								id={fact.id}
								class:list={[
									"value-swap font-bold uppercase truncate max-w-full sm:text-right sm:max-w-[65%]",
									fact.label === "Status" && "text-accent-text",
								]}
							>{fact.label === "Status" && <span class="live-dot live-dot-inline" aria-hidden="true"></span>}{fact.value}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-16">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 max-w-5xl">
			<p class="lg:col-span-3 eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em]" data-scramble>
				N&deg; 01.1 &mdash; Profile
			</p>
			<p class="lg:col-span-9 text-lg sm:text-xl leading-relaxed text-neutral-700 dark:text-neutral-300">
				I'm a Software Engineering student at Universitat de Lleida,
				currently applying what I learn as an intern at IFR Group. My
				focus spans the full stack &mdash; from low-level C and
				Assembly to modern frameworks like Django, React and Astro
				&mdash; and I like moving fast: a 24-hour hackathon win and
				20+ academic projects along the way. Outside of coursework,
				I'm drawn to embedded systems and 3D web graphics.
			</p>
		</div>
	</section>

	<section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-10 flex flex-col sm:flex-row items-center gap-8">
		<div
			style="width: 180px; height: 180px;"
		>
			<canvas
				id="home-globe"
				width="360"
				height="360"
				style="width: 180px; height: 180px; display: block; touch-action: none; -webkit-user-select: none; user-select: none;"
			></canvas>
		</div>
		<div class="text-center sm:text-left">
			<p class="eyebrow justify-center sm:justify-start font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-2" data-scramble>
				N&deg; 01.2 &mdash; Location
			</p>
			<p data-reveal class="text-2xl sm:text-3xl font-black uppercase">
				Based In Andorra<span class="text-accent stamp-dot">.</span>
			</p>
			<p class="font-mono text-xs text-neutral-500 dark:text-neutral-400 mt-1">
				42.5063&deg; N, 1.5218&deg; E
			</p>
		</div>
	</section>

	<section id="highlight-grid" data-stagger="70" class="relative isolate grid grid-cols-1 md:grid-cols-3 border-b-2 border-ink dark:border-paper">
		<span id="highlight-ink" class="slide-ink hidden md:block" aria-hidden="true"></span>
		{highlights.map((item, i) => (
			<div
				class:list={[
					"highlight-item stagger-item p-8 sm:p-10",
					i !== highlights.length - 1 && "border-b-2 md:border-b-0 md:border-r-2 border-ink dark:border-paper",
				]}
			>
				<span class="font-mono text-xs text-accent-text">{item.n}</span>
				<h3 class="text-2xl font-black uppercase mt-3 mb-3">{item.title}</h3>
				<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
					{item.text}
				</p>
			</div>
		))}
	</section>

	<section class="marquee-band bg-ink text-paper dark:bg-paper dark:text-ink overflow-hidden whitespace-nowrap">
		<div class="flex w-max animate-marquee font-mono text-sm uppercase tracking-widest py-4">
			<div class="flex items-center pr-6">
				{stack.map((tech) => (
					<>
						{tech}
						<span class="text-accent mx-6">/</span>
					</>
				))}
			</div>
			<div class="flex items-center pr-6" aria-hidden="true">
				{stack.map((tech) => (
					<>
						{tech}
						<span class="text-accent mx-6">/</span>
					</>
				))}
			</div>
		</div>
		<div class="flex w-max animate-marquee-reverse text-2xl sm:text-3xl font-black uppercase tracking-tight py-3 border-t border-neutral-700 dark:border-neutral-300" aria-hidden="true">
			<div class="flex items-center pr-6">
				{words.map((word) => (
					<>
						{word}
						<span class="text-accent mx-6">/</span>
					</>
				))}
			</div>
			<div class="flex items-center pr-6" aria-hidden="true">
				{words.map((word) => (
					<>
						{word}
						<span class="text-accent mx-6">/</span>
					</>
				))}
			</div>
		</div>
	</section>

	<script is:inline>
		document.addEventListener("astro:page-load", () => {
			const el = document.getElementById("gh-latest");
			if (!el || el.dataset.loaded) return;
			el.dataset.loaded = "pending";

			const timeAgo = (date) => {
				const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
				const intervals = [
					["y", 31536000],
					["mo", 2592000],
					["d", 86400],
					["h", 3600],
					["m", 60],
				];
				for (const [label, secs] of intervals) {
					const count = Math.floor(seconds / secs);
					if (count >= 1) return `${count}${label} ago`;
				}
				return "just now";
			};

			const setValue = (text, title) => {
				el.classList.add("is-swapping");
				window.setTimeout(() => {
					el.textContent = text;
					if (title) el.title = title;
					el.classList.remove("is-swapping");
				}, 160);
			};

			fetch(
				"https://api.github.com/users/DiogoPires2003/repos?sort=pushed&direction=desc&per_page=1"
			)
				.then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
				.then((repos) => {
					const repo = repos[0];
					if (!repo) {
						setValue("No activity");
						return;
					}
					setValue(
						`${repo.name} · ${timeAgo(new Date(repo.pushed_at))}`,
						`Last push to ${repo.full_name}`
					);
				})
				.catch(() => {
					setValue("Unavailable");
				});

		});
	</script>

	<script>
		import createGlobe from "cobe";

		let globeInstance;
		let globeRafId;

		function destroyGlobe() {
			if (globeRafId) {
				cancelAnimationFrame(globeRafId);
				globeRafId = null;
			}
			if (globeInstance) {
				globeInstance.destroy();
				globeInstance = null;
			}
		}

		function initGlobe() {
			const canvas = document.getElementById("home-globe");
			if (!canvas) return;
			destroyGlobe();

			const reduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)"
			).matches;
			// Andorra: 42.5063N, 1.5218E — start with it roughly facing the viewer
			let phi = -Math.PI / 2;

			globeInstance = createGlobe(canvas, {
				devicePixelRatio: 2,
				width: 360,
				height: 360,
				phi,
				theta: 0.32,
				dark: 0,
				diffuse: 1.2,
				scale: 1,
				mapSamples: 16000,
				mapBrightness: 6,
				baseColor: [1, 1, 1],
				markerColor: [230 / 255, 57 / 255, 70 / 255],
				glowColor: [1, 1, 1],
				markers: [{ location: [42.5063, 1.5218], size: 0.1 }],
			});

			if (reduced) return;

			// Drag to spin. The pointer offset feeds a velocity that keeps
			// running after release and eases back into the idle drift, so the
			// globe never stops dead against the finger.
			let pointerDown = false;
			let lastX = 0;
			let velocity = 0;
			const IDLE = 0.001;

			canvas.style.cursor = "grab";

			const onDown = (event) => {
				pointerDown = true;
				lastX = event.clientX;
				canvas.style.cursor = "grabbing";
				canvas.setPointerCapture(event.pointerId);
			};
			const onMove = (event) => {
				if (!pointerDown) return;
				const delta = event.clientX - lastX;
				lastX = event.clientX;
				velocity = delta * 0.005;
				phi -= velocity;
			};
			const onUp = (event) => {
				if (!pointerDown) return;
				pointerDown = false;
				canvas.style.cursor = "grab";
				if (canvas.hasPointerCapture?.(event.pointerId)) {
					canvas.releasePointerCapture(event.pointerId);
				}
			};

			canvas.addEventListener("pointerdown", onDown);
			canvas.addEventListener("pointermove", onMove);
			canvas.addEventListener("pointerup", onUp);
			canvas.addEventListener("pointercancel", onUp);

			const animate = () => {
				if (!pointerDown) {
					// Bleed the throw off, then settle back to the idle drift.
					velocity *= 0.95;
					phi += IDLE - velocity;
				}
				globeInstance.update({ phi });
				globeRafId = requestAnimationFrame(animate);
			};
			globeRafId = requestAnimationFrame(animate);
		}

		document.addEventListener("astro:page-load", initGlobe);
		document.addEventListener("astro:before-swap", destroyGlobe);
	</script>
</Layout>
