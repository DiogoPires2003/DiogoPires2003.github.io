---
import Layout from "../layouts/Layout.astro";

const milestones = [
    {
        date: "2021 — 2027",
        title: "Software Engineering Degree",
        description: "Studying Software Engineering at Universitat de Lleida.",
        tags: ["Universitat de Lleida", "Software Engineering"],
    },
    {
        date: "2022",
        title: "Docker Certificate",
        description: "Certificate completed at Universitat de Lleida.",
        tags: ["Docker", "Universitat de Lleida"],
    },
    {
        date: "March 2026",
        title: "Internship at IFR Group",
        description:
            "Started internship experience focused on real-world software engineering.",
        tags: ["IFR Group", "Internship"],
        current: true,
    },
    {
        date: "2027",
        title: "Expected Graduation",
        description: "Planned completion of the Software Engineering degree.",
        tags: ["Milestone"],
        future: true,
    },
];

const stats = [
    {
        n: "01",
        value: "1",
        label: "Hackathon win",
        countTo: 1,
        countSuffix: "",
        countDecimals: 0,
    },
    {
        n: "02",
        value: "20+",
        label: "Academic projects",
        countTo: 20,
        countSuffix: "+",
        countDecimals: 0,
    },
    { n: "03", value: "In progress", label: "Software Engineering degree" },
];
---

<Layout title="Diogo Pires | Academic">
    <section class="screen-page grid grid-rows-[auto_minmax(0,1fr)_auto]">
        <header data-reveal class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-end px-4 sm:px-6 lg:px-10 py-10 sm:py-12 lg:py-5 border-b-2 border-ink dark:border-paper">
            <div class="lg:col-span-6">
                <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-4" data-scramble>
                    [04] Journey
                </p>
                <h1 class="fit-h1-sm text-4xl sm:text-6xl font-black uppercase leading-[0.95] tracking-[-0.035em]">
                    <span class="reveal-line" style="--i:0"><span>Education &amp;</span></span><span class="reveal-line" style="--i:1"><span>Certifications<span class="text-accent stamp-dot">.</span></span></span>
                </h1>
            </div>
            <p class="reveal-up lg:col-span-6 text-sm sm:text-base lg:text-sm xl:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
                I'm a Software Engineering student at Universitat de Lleida,
                currently applying what I learn as an intern at IFR Group. My
                focus spans the full stack, from low-level C and Assembly to
                Django, React and Astro, and I like moving fast: a 24-hour
                hackathon win and 20+ academic projects along the way.
                Outside of coursework, I'm drawn to embedded systems and 3D
                web graphics.
            </p>
        </header>

        <ol data-stagger="70" class="timeline fit-scroll grid grid-cols-1 lg:grid-cols-4 min-h-0">
            {milestones.map((item, i) => (
                <li
                    class:list={[
                        "timeline-item stagger-item relative flex flex-col px-4 sm:px-6 lg:px-8 pb-8 lg:pb-5 pt-8 lg:pt-12",
                        i !== milestones.length - 1 && "lg:border-r border-neutral-300 dark:border-neutral-700",
                        item.current && "is-current",
                        item.future && "is-future",
                    ]}
                >
                    <span class="timeline-node" aria-hidden="true"></span>
                    <div class="flex items-center justify-between gap-3 font-mono text-xs uppercase tracking-widest">
                        <span class="text-accent-text">{String(i + 1).padStart(2, "0")}</span>
                        <span class="text-neutral-500 dark:text-neutral-400">
                            {item.current && <span class="live-dot live-dot-inline" aria-hidden="true"></span>}{item.date}
                        </span>
                    </div>
                    <h3 class="timeline-title mt-3 text-xl sm:text-2xl font-black uppercase tracking-tight leading-[1.05]">
                        {item.title}
                    </h3>
                    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                        {item.description}
                    </p>
                    <div class="mt-auto pt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                        {item.tags.map((tag) => (
                            <span class="flex items-center gap-2">
                                <span class="text-accent-text">/</span>
                                {tag}
                            </span>
                        ))}
                    </div>
                </li>
            ))}
        </ol>

        <div class="grid grid-cols-1 sm:grid-cols-3 border-t-2 border-ink dark:border-paper">
            {stats.map((stat, i) => (
                <div
                    data-reveal
                    style={`--i:${i}`}
                    class:list={[
                        "stat-line grid grid-cols-[auto_1fr] items-baseline gap-x-3 px-4 sm:px-6 lg:px-8 py-4 lg:py-3 min-w-0",
                        i !== stats.length - 1 && "border-b sm:border-b-0 sm:border-r border-neutral-300 dark:border-neutral-700",
                    ]}
                >
                    <span class="font-mono text-xs text-accent-text">{stat.n}</span>
                    {stat.countTo !== undefined ? (
                        <p class="text-2xl font-black uppercase flex items-baseline shrink-0">
                            <number-flow class="stat-number" data-count-to={stat.countTo}></number-flow><span>{stat.countSuffix}</span>
                        </p>
                    ) : (
                        <p class="text-2xl font-black uppercase shrink-0">{stat.value}</p>
                    )}
                    <p class="col-start-2 text-[11px] uppercase tracking-widest text-neutral-500 dark:text-neutral-400 leading-snug">{stat.label}</p>
                </div>
            ))}
        </div>
    </section>

    <script>
        import "number-flow";

        document.addEventListener("astro:page-load", () => {
            const stats = Array.from(
                document.querySelectorAll("number-flow[data-count-to]")
            );
            if (!stats.length) return;

            stats.forEach((el) => el.update(0));

            const reveal = (el) => el.update(parseFloat(el.dataset.countTo));

            if ("IntersectionObserver" in window) {
                const statObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                reveal(entry.target);
                                statObserver.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.4 }
                );
                stats.forEach((el) => statObserver.observe(el));
            } else {
                stats.forEach(reveal);
            }
        });
    </script>
</Layout>
