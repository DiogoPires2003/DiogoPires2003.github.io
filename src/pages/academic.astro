---
import Layout from "../layouts/Layout.astro";

const milestones = [
    {
        date: "2021 — 2027",
        title: "Software Engineering Degree",
        description: "Studying Software Engineering at Universitat de Lleida.",
        tags: ["Universitat de Lleida", "Software Engineering"],
    },
    {
        date: "2022",
        title: "Docker Certificate",
        description: "Certificate completed at Universitat de Lleida.",
        tags: ["Docker", "Universitat de Lleida"],
    },
    {
        date: "March 2026",
        title: "Internship at IFR Group",
        description:
            "Started internship experience focused on real-world software engineering.",
        tags: ["IFR Group", "Internship"],
    },
    {
        date: "2027",
        title: "Expected Graduation",
        description: "Planned completion of the Software Engineering degree.",
        tags: ["Milestone"],
    },
];

const stats = [
    {
        n: "01",
        value: "1",
        label: "Hackathon win",
        countTo: 1,
        countSuffix: "",
        countDecimals: 0,
    },
    {
        n: "02",
        value: "20+",
        label: "Academic projects",
        countTo: 20,
        countSuffix: "+",
        countDecimals: 0,
    },
    { n: "03", value: "In progress", label: "Software Engineering degree" },
];
---

<Layout title="Diogo Pires | Academic">
    <section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-20">
        <p class="font-mono text-xs text-accent uppercase tracking-[0.25em] mb-6">
            N&deg; 03 &mdash; Journey
        </p>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase leading-[0.95] tracking-tight mb-6 max-w-3xl">
            Education &amp;<br />Certifications<span class="text-accent">.</span>
        </h1>
        <p class="max-w-2xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
            A record of my progress in software engineering, from core
            learning to applied technical experience.
        </p>
    </section>

    <section class="border-b-2 border-ink dark:border-paper">
        {milestones.map((item, i) => (
            <div
                class:list={[
                    "milestone-item grid grid-cols-1 sm:grid-cols-12 opacity-0 translate-y-2 transition-[opacity,transform] duration-500 ease-out motion-reduce:transition-none motion-reduce:duration-0",
                    i !== milestones.length - 1 && "border-b border-neutral-300 dark:border-neutral-700",
                ]}
            >
                <div class="sm:col-span-3 lg:col-span-2 px-4 sm:px-6 lg:px-12 py-6 sm:py-8 flex sm:flex-col justify-between sm:justify-start gap-2 border-b sm:border-b-0 sm:border-r border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900/40">
                    <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, "0")}</span>
                    <span class="font-mono text-xs uppercase tracking-widest text-neutral-500">
                        {item.date}
                    </span>
                </div>
                <div class="sm:col-span-9 lg:col-span-10 px-4 sm:px-6 lg:px-12 py-6 sm:py-8">
                    <h3 class="text-xl sm:text-3xl font-black uppercase tracking-tight mb-3">
                        {item.title}
                    </h3>
                    <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4 max-w-2xl">
                        {item.description}
                    </p>
                    <div class="flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px] uppercase tracking-widest text-neutral-500">
                        {item.tags.map((tag) => (
                            <span class="flex items-center gap-2">
                                <span class="text-accent">/</span>
                                {tag}
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        ))}
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3">
        {stats.map((stat, i) => (
            <div
                class:list={[
                    "px-4 sm:px-6 lg:px-12 py-8 sm:py-10",
                    i !== stats.length - 1 && "sm:border-r border-neutral-300 dark:border-neutral-700",
                ]}
            >
                <span class="font-mono text-xs text-accent">{stat.n}</span>
                {stat.countTo !== undefined ? (
                    <p
                        class="count-up text-2xl sm:text-3xl font-black uppercase mt-3"
                        data-count-to={stat.countTo}
                        data-count-suffix={stat.countSuffix}
                        data-count-decimals={stat.countDecimals}
                    >
                        0{stat.countSuffix}
                    </p>
                ) : (
                    <p class="text-2xl sm:text-3xl font-black uppercase mt-3">{stat.value}</p>
                )}
                <p class="text-xs uppercase tracking-widest text-neutral-500 mt-1">{stat.label}</p>
            </div>
        ))}
    </section>

    <script is:inline>
        document.addEventListener("astro:page-load", () => {
            const items = document.querySelectorAll(".milestone-item");
            if (!items.length) return;

            const reveal = (el) => {
                el.classList.remove("opacity-0", "translate-y-2");
            };

            if ("IntersectionObserver" in window) {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                reveal(entry.target);
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.15 }
                );
                items.forEach((item) => observer.observe(item));
            } else {
                items.forEach(reveal);
            }
        });
    </script>
</Layout>
