---
// Hexterra lives outside the portfolio Layout: it needs the whole viewport,
// and without ClientRouter here the portfolio does a full page load into it,
// so Three.js never leaks into the other pages.

const title = "Hexterra | Diogo Pires";
const description = "Juego de estrategia por turnos en 3D sobre un planeta recién terraformado.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#11151c" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Orbitron:wght@500;700;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <main class="hx" data-hexterra data-state="loading" data-phase="boot">
            <canvas aria-label="Tablero de Hexterra. Arrastra para girar la cámara y usa la rueda o pellizca para hacer zoom."></canvas>
            <div class="vignette" aria-hidden="true"></div>

            <a class="brand panel-in" href="/projects/" aria-label="Volver al portfolio" title="Volver al portfolio" style="--d: 0">
                <svg class="logo" viewBox="0 0 48 48" aria-hidden="true">
                    <path d="M24 3 42 13.5v21L24 45 6 34.5v-21z" />
                    <path d="M24 13 33 18.25v10.5L24 34l-9-5.25v-10.5z" />
                    <path d="M24 3v10M42 13.5l-9 4.75M42 34.5l-9-5.75M24 45V34M6 34.5l9-5.75M6 13.5l9 4.75" />
                </svg>
                <span>
                    <span class="title">HEXTERRA</span>
                    <span class="sub">Planeta KX-7 · Terraformación 98%</span>
                </span>
            </a>

            <div class="audio-ctl panel-in" style="--d: 1">
                <button type="button" data-game-menu aria-label="Menú" title="Volver al menú">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <button type="button" data-toggle-music aria-pressed="true" aria-label="Música">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /><path class="off" d="M3 3l18 18" /></svg>
                </button>
                <button type="button" data-toggle-sfx aria-pressed="true" aria-label="Efectos de sonido">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" /><path class="on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /><path class="off" d="M16 9l6 6M22 9l-6 6" /></svg>
                </button>
            </div>
            <div class="ui panel-in" data-ui style="--d: 1"></div>
            <div class="tip" data-tip hidden></div>
            <div class="modal-wrap handoff" data-handoff hidden></div>

            <p class="hint intro-hint">Pulsa cualquier tecla o toca para saltar</p>

            <div class="boot">
                <svg class="boot-logo" viewBox="0 0 48 48" aria-hidden="true">
                    <path d="M24 3 42 13.5v21L24 45 6 34.5v-21z" />
                    <path d="M24 13 33 18.25v10.5L24 34l-9-5.25v-10.5z" />
                </svg>
                <p class="boot-title">HEXTERRA</p>
                <div class="boot-bar" data-boot-progress><span></span></div>
                <p class="boot-line" aria-hidden="true">Descargando el planeta…</p>
                <button type="button" class="btn primary boot-enter" data-enter>Entrar</button>
                <p class="boot-note">Mejor con sonido</p>
            </div>

            <p class="notice" role="alert">
                Tu navegador no puede mostrar WebGL, que Hexterra necesita para dibujar el planeta.
            </p>
        </main>

        <script>
            import { startHexterra } from "../../hexterra/main";

            const root = document.querySelector<HTMLElement>("[data-hexterra]");
            if (root) startHexterra(root);
        </script>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        height: 100%;
        background: #11151c;
        color: #ece8e1;
        font-family: "Chakra Petch", ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
        overscroll-behavior: none;
    }
</style>

<!-- The interface is built at runtime by ui/hud.ts, so its styles are global (scoped under .hx by hand). -->
<style is:global>
    .hx {
        --text: #ece8e1;
        --muted: rgb(236 232 225 / 0.62);
        --accent: #a9cdd6;
        --panel: rgb(16 20 27 / 0.66);
        --panel-solid: rgb(20 24 32 / 0.92);
        --line: rgb(255 255 255 / 0.1);
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --gap: max(16px, env(safe-area-inset-left));
        position: fixed;
        inset: 0;
        overflow: hidden;
        color: var(--text);
        background: #1b2230;
        user-select: none;
        -webkit-user-select: none;
        font-size: 14px;
    }
    .hx *,
    .hx *::before,
    .hx *::after {
        box-sizing: border-box;
    }
    .hx canvas {
        display: block;
        width: 100%;
        height: 100%;
        touch-action: none;
        cursor: grab;
        outline: none;
    }
    .hx canvas:active {
        cursor: grabbing;
    }
    .hx p {
        margin: 0;
    }
    .hx [hidden] {
        display: none !important;
    }
    .hx .vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(ellipse at center, transparent 60%, rgb(0 0 0 / 0.35) 100%);
    }
    .hx .hint-text {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.45;
    }
    .hx .error {
        color: #f2a08f;
        font-size: 13px;
    }
    .hx .eyebrow {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
    }

    /* ---------- Entrance ---------- */
    .hx .panel-in {
        opacity: 0;
        transform: translateY(-6px);
        transition:
            opacity 600ms var(--ease-out),
            transform 700ms var(--ease-out);
        transition-delay: calc(var(--d, 0) * 90ms);
    }
    .hx[data-phase="play"] .panel-in {
        opacity: 1;
        transform: none;
    }
    .hx[data-phase="intro"] .ui {
        pointer-events: none;
    }

    .hx .panel {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        backdrop-filter: blur(16px) saturate(120%);
        -webkit-backdrop-filter: blur(16px) saturate(120%);
        box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    }

    /* ---------- Brand ---------- */
    .hx .brand {
        position: absolute;
        top: max(18px, env(safe-area-inset-top));
        left: var(--gap);
        display: flex;
        align-items: center;
        gap: 12px;
        color: inherit;
        text-decoration: none;
        text-shadow: 0 1px 12px rgb(0 0 0 / 0.45);
        z-index: 3;
    }
    .hx .logo {
        width: 30px;
        height: 30px;
        fill: none;
        stroke: var(--text);
        stroke-width: 1.4;
    }
    .hx .title {
        display: block;
        font-family: "Orbitron", sans-serif;
        font-weight: 700;
        font-size: 18px;
        letter-spacing: 0.34em;
    }
    .hx .sub {
        display: block;
        margin-top: 3px;
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .hx .brand:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
    }

    /* ---------- Buttons ---------- */
    .hx .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font: 600 12px/1 "Chakra Petch", sans-serif;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #15191f;
        background: var(--text);
        border: 0;
        border-radius: 8px;
        padding: 11px 15px;
        cursor: pointer;
        transition:
            transform 140ms var(--ease-out),
            background-color 180ms,
            opacity 180ms;
        -webkit-tap-highlight-color: transparent;
    }
    .hx .btn:active:not(:disabled) {
        transform: scale(0.97);
    }
    .hx .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    .hx .btn.ghost {
        color: var(--text);
        background: rgb(255 255 255 / 0.06);
        box-shadow: inset 0 0 0 1px var(--line);
    }
    .hx .btn.small {
        padding: 8px 11px;
        font-size: 11px;
    }
    .hx .btn.wide {
        width: 100%;
    }
    .hx .btn .mi {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
    }
    .hx .link {
        background: none;
        border: 0;
        color: var(--muted);
        font: inherit;
        font-size: 12px;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
        padding: 4px;
    }
    @media (hover: hover) {
        .hx .btn:not(:disabled):hover {
            background: #fff;
        }
        .hx .btn.ghost:not(:disabled):hover {
            background: rgb(255 255 255 / 0.12);
        }
        .hx .link:hover {
            color: var(--text);
        }
    }
    .hx button:focus-visible,
    .hx input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .hx .ri {
        fill: none;
        stroke: var(--c);
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex: none;
    }
    .hx .mi {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
        vertical-align: -2px;
    }
    .hx .chip {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 3px;
        border-radius: 6px;
        background: rgb(255 255 255 / 0.08);
        font-size: 12px;
    }
    .hx .chips {
        display: inline-flex;
        gap: 3px;
        flex-wrap: wrap;
    }
    .hx .swatch {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        background: var(--p);
        flex: none;
    }

    /* ---------- Audio toggles ---------- */
    .hx .audio-ctl {
        position: absolute;
        top: max(18px, env(safe-area-inset-top));
        right: var(--gap);
        display: flex;
        gap: 6px;
        z-index: 3;
    }
    .hx .audio-ctl button {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--panel);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        color: var(--text);
        cursor: pointer;
        transition:
            transform 140ms var(--ease-out),
            opacity 180ms;
    }
    .hx .audio-ctl button:active {
        transform: scale(0.94);
    }
    .hx .audio-ctl svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .hx:not([data-playing="true"]) [data-game-menu] {
        display: none;
    }
    .hx .audio-ctl .off {
        display: none;
    }
    .hx .audio-ctl [aria-pressed="false"] {
        opacity: 0.55;
    }
    .hx .audio-ctl [aria-pressed="false"] .off {
        display: inline;
    }
    .hx .audio-ctl [aria-pressed="false"] .on {
        display: none;
    }

    /* ---------- Main menu ---------- */
    .hx .menu-card {
        width: min(460px, 100%);
        gap: 16px;
        padding: 28px 26px 18px;
    }
    .hx .menu-title {
        margin: 0;
        font-family: "Orbitron", sans-serif;
        font-weight: 700;
        font-size: clamp(30px, 6vw, 40px);
        letter-spacing: 0.3em;
        margin-right: -0.3em;
    }
    .hx .pitch {
        font-size: 14px;
        line-height: 1.55;
        color: rgb(236 232 225 / 0.85);
    }
    .hx .pitch-points {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 9px;
        font-size: 13px;
        color: var(--muted);
    }
    .hx .pitch-points li {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .hx .menu-actions {
        display: grid;
        gap: 8px;
        margin-top: 4px;
    }
    .hx .btn.accent {
        background: #e7cf9c;
        color: #1c1913;
    }
    .hx .lobby-links {
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }
    .hx .modal > .link {
        justify-self: center;
    }

    /* ---------- Tutorial coach ---------- */
    .hx .coach {
        right: var(--gap);
        bottom: max(18px, env(safe-area-inset-bottom));
        width: 300px;
        padding: 16px 16px 10px;
        display: grid;
        gap: 8px;
        background: var(--panel-solid);
        border-color: rgb(231 207 156 / 0.45);
        animation: modal-in 320ms var(--ease-out);
        z-index: 3;
    }
    .hx .coach h3 {
        margin: 0;
        font-size: 16px;
    }
    .hx .coach-text {
        font-size: 13px;
        line-height: 1.55;
        color: rgb(236 232 225 / 0.86);
    }
    .hx .coach-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2px;
    }
    .hx .coach .dots {
        display: flex;
        gap: 4px;
    }
    .hx .coach .dots i {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgb(255 255 255 / 0.15);
    }
    .hx .coach .dots i.done {
        background: rgb(231 207 156 / 0.6);
    }
    .hx .coach .dots i.now {
        background: #e7cf9c;
    }
    .hx .coach .waiting {
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #e7cf9c;
        animation: blink-soft 1.6s ease-in-out infinite;
    }
    .hx .coach .link {
        justify-self: start;
        padding-left: 0;
    }
    .hx .coach-target {
        outline: 2px solid #e7cf9c;
        outline-offset: 4px;
        border-radius: 10px;
        animation: spotlight 1.6s ease-in-out infinite;
    }
    @media (max-width: 1300px) and (min-width: 761px) {
        .hx .coach {
            bottom: calc(var(--dock-h, 180px) + 14px);
        }
    }
    @keyframes spotlight {
        50% {
            outline-color: rgb(231 207 156 / 0.25);
            outline-offset: 7px;
        }
    }
    @keyframes blink-soft {
        50% {
            opacity: 0.45;
        }
    }

    /* ---------- Lobby ---------- */
    .hx .lobby {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 80px var(--gap) var(--gap);
        pointer-events: none;
    }
    .hx .lobby-card {
        pointer-events: auto;
        width: min(420px, 100%);
        padding: 22px;
        display: grid;
        gap: 14px;
        background: var(--panel-solid);
    }
    .hx .lobby-card h2 {
        margin: 0;
        font-family: "Orbitron", sans-serif;
        font-size: 16px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }
    .hx .lobby-body {
        display: grid;
        gap: 12px;
    }
    .hx .tabs {
        display: flex;
        gap: 4px;
        padding: 4px;
        border-radius: 10px;
        background: rgb(255 255 255 / 0.05);
    }
    .hx .tabs button {
        flex: 1;
        border: 0;
        background: none;
        color: var(--muted);
        font: 600 12px "Chakra Petch", sans-serif;
        letter-spacing: 0.06em;
        padding: 9px 6px;
        border-radius: 7px;
        cursor: pointer;
    }
    .hx .tabs button[aria-selected="true"] {
        background: rgb(255 255 255 / 0.1);
        color: var(--text);
    }
    .hx .tabs button:disabled {
        cursor: default;
    }
    .hx .seats {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 6px;
    }
    .hx .seats li {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 8px;
        border-radius: 8px;
        background: rgb(255 255 255 / 0.04);
        border-left: 3px solid var(--p);
    }
    .hx .seats input,
    .hx .field input {
        flex: 1;
        min-width: 0;
        font: inherit;
        font-size: 16px;
        color: var(--text);
        background: rgb(255 255 255 / 0.06);
        border: 1px solid var(--line);
        border-radius: 7px;
        padding: 8px 10px;
        user-select: text;
    }
    .hx .seats input {
        font-size: 14px;
        background: transparent;
        border-color: transparent;
    }
    .hx .seat-name {
        flex: 1;
    }
    .hx .kind {
        font: 600 11px "Chakra Petch", sans-serif;
        letter-spacing: 0.06em;
        color: var(--text);
        background: rgb(255 255 255 / 0.08);
        border: 0;
        border-radius: 6px;
        padding: 6px 9px;
        cursor: pointer;
    }
    .hx .kind.static {
        background: none;
        color: var(--muted);
        cursor: default;
    }
    .hx .x {
        border: 0;
        background: none;
        color: var(--muted);
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
        padding: 0 4px;
    }
    .hx .field {
        display: grid;
        gap: 6px;
        font-size: 12px;
        color: var(--muted);
    }
    .hx .code-input {
        font-family: "Orbitron", sans-serif !important;
        letter-spacing: 0.3em;
        text-transform: uppercase;
    }
    .hx .planet-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 13px;
        color: var(--muted);
    }
    .hx .planet-row b {
        color: var(--text);
    }
    .hx .room-code {
        display: grid;
        justify-items: center;
        gap: 6px;
        padding: 12px;
        border-radius: 10px;
        background: rgb(255 255 255 / 0.05);
    }
    .hx .room-code span {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .hx .room-code strong {
        font-family: "Orbitron", sans-serif;
        font-size: 30px;
        letter-spacing: 0.3em;
        margin-right: -0.3em;
        user-select: all;
    }

    /* ---------- Game layout ---------- */
    .hx .game > * {
        position: absolute;
    }
    .hx .banner {
        top: max(18px, env(safe-area-inset-top));
        left: 50%;
        translate: -50% 0;
        display: grid;
        justify-items: center;
        gap: 3px;
        padding: 10px 18px;
        border-radius: 999px;
        background: var(--panel);
        border: 1px solid var(--line);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        font-size: 14px;
        text-align: center;
        max-width: min(560px, calc(100% - 420px));
        transition: box-shadow 300ms;
    }
    .hx .banner[data-mine="true"] {
        box-shadow:
            0 0 0 1px rgb(255 255 255 / 0.35),
            0 10px 30px rgb(0 0 0 / 0.3);
    }
    .hx .banner .round {
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .hx .dice {
        top: calc(max(18px, env(safe-area-inset-top)) + 64px);
        left: 50%;
        translate: -50% 0;
        display: flex;
        gap: 8px;
        pointer-events: none;
    }
    .hx .die {
        width: 34px;
        height: 34px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        padding: 5px;
        border-radius: 8px;
        background: #ece8e1;
        box-shadow: 0 6px 16px rgb(0 0 0 / 0.35);
        animation: die-in 520ms var(--ease-out);
    }
    .hx .die i {
        place-self: center;
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }
    .hx .die i.on {
        background: #1d2128;
    }
    .hx .die + .die {
        animation-delay: 60ms;
    }
    @keyframes die-in {
        from {
            transform: translateY(-14px) rotate(-120deg) scale(0.6);
            opacity: 0;
        }
    }
    .hx .room-chip {
        top: max(18px, env(safe-area-inset-top));
        right: calc(var(--gap) + 128px);
        font: 500 12px "Chakra Petch", sans-serif;
        letter-spacing: 0.1em;
        color: var(--muted);
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 9px 14px;
    }
    .hx .room-chip b {
        color: var(--text);
        font-family: "Orbitron", sans-serif;
        letter-spacing: 0.2em;
    }

    .hx .players {
        top: calc(max(18px, env(safe-area-inset-top)) + 50px);
        right: var(--gap);
        width: 230px;
        display: grid;
        gap: 8px;
    }
    .hx .player {
        padding: 10px 12px;
        border-left: 3px solid var(--p);
        transition:
            transform 300ms var(--ease-out),
            background-color 300ms;
    }
    .hx .player.active {
        background: rgb(30 36 46 / 0.82);
        transform: translateX(-6px);
    }
