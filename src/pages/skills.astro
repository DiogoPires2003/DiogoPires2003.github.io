---
import Layout from "../layouts/Layout.astro";

const nodeCards = [
    {
        name: "Java",
        category: "Languages",
        detail: "Object-oriented systems",
        proficiency: 60,
    },
    {
        name: "Python",
        category: "Languages",
        detail: "Automation & scripting",
        proficiency: 60,
    },
    {
        name: "JavaScript",
        category: "Languages",
        detail: "Web application logic",
        proficiency: 70,
    },
    {
        name: "TypeScript",
        category: "Languages",
        detail: "Typed frontend architecture",
        proficiency: 50,
    },
    {
        name: "C",
        category: "Languages",
        detail: "Low-level programming",
        proficiency: 85,
    },
    {
        name: "Assembly",
        category: "Languages",
        detail: "Hardware-adjacent optimization",
        proficiency: 40,
    },
    {
        name: "Scala",
        category: "Languages",
        detail: "Functional JVM development",
        proficiency: 20,
    },
    {
        name: "HTML",
        category: "Languages",
        detail: "Semantic document structure",
        proficiency: 90,
    },
    {
        name: "CSS",
        category: "Languages",
        detail: "Responsive UI styling",
        proficiency: 90,
    },
    {
        name: "X++",
        category: "Languages",
        detail: "Dynamics AX business logic scripting",
        proficiency: 50,
    },
    {
        name: "React",
        category: "Frameworks",
        detail: "Component-driven UI development",
        proficiency: 60,
    },
    {
        name: "Solid JS",
        category: "Frameworks",
        detail: "Fine-grained reactive interfaces",
        proficiency: 60,
    },
    {
        name: "Astro",
        category: "Frameworks",
        detail: "Content-focused web architecture",
        proficiency: 70,
    },
    {
        name: "Django",
        category: "Frameworks",
        detail: "Backend framework engineering",
        proficiency: 95,
    },
    {
        name: "Three.js",
        category: "Frameworks",
        detail: "3D web scene programming",
        proficiency: 50,
    },
    {
        name: "MySQL",
        category: "Databases",
        detail: "Relational data modeling",
        proficiency: 90,
    },
    {
        name: "PostgreSQL",
        category: "Databases",
        detail: "Advanced SQL workloads",
        proficiency: 90,
    },
    {
        name: "Docker",
        category: "Tools",
        detail: "Containerized deployment pipelines",
        proficiency: 75,
    },
    {
        name: "Bash Script",
        category: "Tools",
        detail: "Shell automation",
        proficiency: 75,
    },
    {
        name: "Arduino",
        category: "Tools",
        detail: "Embedded prototyping",
        proficiency: 75,
    },
    {
        name: "Power Platform",
        category: "Platforms",
        detail: "Low-code apps & workflow automation",
        proficiency: 50,
    },
    {
        name: "Dynamics 365",
        category: "Platforms",
        detail: "Cloud ERP & CRM customization",
        proficiency: 50,
    },
    {
        name: "Dynamics AX 2012",
        category: "Platforms",
        detail: "Legacy ERP customization (X++)",
        proficiency: 50,
    },
];

const lastUpdated = new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
}).format(new Date());

const byCategory = (category: string) =>
    nodeCards
        .filter((card) => card.category === category)
        .sort((a, b) => b.proficiency - a.proficiency);

// Languages fill a column on their own; the smaller groups share one.
const columns = [
    ["Languages"],
    ["Frameworks", "Databases"],
    ["Tools", "Platforms"],
].map((column) =>
    column.map((category) => ({ category, cards: byCategory(category) }))
);

const featured = [...nodeCards].sort((a, b) => b.proficiency - a.proficiency)[0];
const slug = (name: string) => name.toLowerCase();
---

<Layout title="Diogo Pires | Skills">
    <section
        id="skills-board"
        class="screen-page grid grid-rows-[auto_minmax(0,1fr)]"
        data-skills={JSON.stringify(nodeCards)}
    >
        <header
            data-reveal
            class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 px-4 sm:px-6 lg:px-10 py-10 sm:py-12 lg:py-6 border-b-2 border-ink dark:border-paper"
        >
            <div>
                <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-4" data-scramble>
                    [02] Technical Stack
                </p>
                <h1 class="fit-h1-sm text-4xl sm:text-6xl font-black uppercase leading-[0.95] tracking-[-0.035em]">
                    <span class="reveal-line" style="--i:0"><span>Skills &amp; Tools<span class="text-accent stamp-dot">.</span></span></span>
                </h1>
            </div>
            <p class="reveal-up font-mono text-[11px] uppercase tracking-widest text-neutral-500 dark:text-neutral-400 lg:text-right leading-relaxed">
                {nodeCards.length} items <span class="text-accent-text">/</span> 1.2M+ lines of code
                <br class="hidden lg:block" />
                <span class="lg:hidden text-accent-text"> / </span>Web &amp; systems <span class="text-accent-text">/</span> Updated {lastUpdated}
            </p>
        </header>

        <div
            data-stagger="18"
            class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-[1.1fr_1fr_1fr_1.15fr] lg:grid-rows-[minmax(0,1fr)] min-h-0"
        >
            {columns.map((column, c) => (
                <div class:list={[
                    "flex flex-col min-h-0 border-ink dark:border-paper",
                    "border-b-2 md:border-b-0 md:border-r-2",
                    c === 2 && "md:border-r-0 lg:border-r-2",
                ]}>
                    {column.map((group, g) => (
                        <div class:list={[
                            "flex flex-col min-h-0",
                            g > 0 && "border-t-2 border-ink dark:border-paper",
                            column.length === 1 ? "flex-1" : g === 0 ? "flex-[1.4]" : "flex-1",
                        ]}>
                            <div class="panel-head">
                                <span>{group.category}</span>
                                <span class="text-accent-text">{String(group.cards.length).padStart(2, "0")}</span>
                            </div>
                            <ul class="fit-scroll flex-1">
                                {group.cards.map((card) => (
                                    <li class="stagger-item">
                                        <button
                                            type="button"
                                            class="skill-row group"
                                            data-cmd={`inspect ${slug(card.name)}`}
                                            data-skill={slug(card.name)}
                                            aria-pressed={card === featured ? "true" : "false"}
                                        >
                                            <span class="min-w-0 text-left">
                                                <span class="row-slide block truncate font-bold uppercase text-sm">{card.name}</span>
                                                <span class="block lg:hidden text-xs text-neutral-500 dark:text-neutral-400 truncate">{card.detail}</span>
                                            </span>
                                            <span class="seg-bar w-16 sm:w-20 lg:w-12 xl:w-16 2xl:w-20" aria-hidden="true">
                                                <span class="skill-bar-fill" data-proficiency={card.proficiency} style="--p: 0;"></span>
                                            </span>
                                            <span class="w-9 text-right font-mono text-xs font-bold tabular-nums">{card.proficiency}%</span>
                                        </button>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            ))}

            <aside id="skill-inspector" class="hidden lg:flex flex-col min-h-0 overflow-hidden" aria-live="polite">
                <div class="panel-head">
                    <span>Inspect</span>
                    <span class="normal-case tracking-normal text-accent-text" data-i="cmd">inspect {slug(featured.name)}</span>
                </div>
                <div class="flex-1 min-h-0 flex flex-col px-6 py-5">
                    <p class="font-mono text-xs text-accent-text uppercase tracking-widest">[<span data-i="category">{featured.category}</span>]</p>
                    <h2 class="mt-2 text-3xl xl:text-4xl font-black uppercase leading-none tracking-tight break-words" data-i="name">{featured.name}</h2>
                    <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed" data-i="detail">{featured.detail}</p>
                    <div class="mt-auto pt-4">
                        <p class="inspect-pct flex items-baseline text-6xl font-black tabular-nums leading-none">
                            <number-flow id="inspect-pct"></number-flow><span class="text-accent">%</span>
                        </p>
                        <span class="seg-bar seg-bar-lg mt-4" aria-hidden="true">
                            <span id="inspect-fill" class="skill-bar-fill" style={`transform: scaleX(${featured.proficiency / 100});`}></span>
                        </span>
                        <p class="inspect-related mt-4 font-mono text-[11px] uppercase tracking-widest text-neutral-500 dark:text-neutral-400">Same category</p>
                        <div class="inspect-related mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-widest" data-i="related"></div>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <script>
        import "number-flow";
        import { register } from "../scripts/shell";

        type Skill = { name: string; category: string; detail: string; proficiency: number };

        document.addEventListener("astro:page-load", () => {
            const board = document.getElementById("skills-board");
            if (!board) return;
            const skills: Skill[] = JSON.parse(board.dataset.skills || "[]");
            const find = (name: string) =>
                skills.find((skill) => skill.name.toLowerCase() === name.toLowerCase());
            const inspector = document.getElementById("skill-inspector");
            const pct = document.getElementById("inspect-pct") as any;
            const fill = document.getElementById("inspect-fill");
            const field = (key: string) => inspector?.querySelector<HTMLElement>(`[data-i="${key}"]`);

            // Text swaps instantly; only the figure animates, because this
            // runs on every hover.
            const inspect = (skill: Skill) => {
                const key = skill.name.toLowerCase();
                board.querySelectorAll<HTMLElement>(".skill-row").forEach((row) =>
                    row.setAttribute("aria-pressed", String(row.dataset.skill === key))
                );
                if (!inspector) return;
                field("name")!.textContent = skill.name;
                field("category")!.textContent = skill.category;
                field("detail")!.textContent = skill.detail;
                field("cmd")!.textContent = `inspect ${key}`;
                pct?.update?.(skill.proficiency);
                if (fill) fill.style.transform = `scaleX(${skill.proficiency / 100})`;
                const related = field("related")!;
                related.textContent = "";
                skills
                    .filter((other) => other.category === skill.category && other !== skill)
                    .forEach((other) => {
                        const chip = document.createElement("button");
                        chip.type = "button";
                        chip.className = "link-ghost";
                        chip.dataset.cmd = `inspect ${other.name.toLowerCase()}`;
                        chip.innerHTML = `<span class="text-accent-text">/</span> `;
                        chip.append(other.name);
                        related.appendChild(chip);
                    });
            };

            inspect(skills.reduce((a, b) => (b.proficiency > a.proficiency ? b : a), skills[0]));

            register({
                name: "inspect",
                usage: "inspect <skill>",
                summary: "Show a skill in the inspector",
                scope: "page",
                complete: () => skills.map((skill) => skill.name.toLowerCase()),
                run({ args, print }) {
                    const skill = find(args.join(" "));
                    if (!skill) {
                        print(`inspect: unknown skill: ${args.join(" ")}`, "accent");
                        return;
                    }
                    inspect(skill);
                    // Without the inspector (small screens) the answer is text.
                    if (!inspector || inspector.offsetParent === null) {
                        print(`${skill.name} [${skill.category}] ${skill.proficiency}%: ${skill.detail}`);
                    }
                },
            });

            // Hovering and focusing browse; clicking runs the command.
            const rows = board.querySelectorAll<HTMLElement>(".skill-row");
            const browse = (row: HTMLElement) => {
                const skill = find(row.dataset.skill || "");
                if (skill) inspect(skill);
            };
            if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
                rows.forEach((row) => row.addEventListener("pointerenter", () => browse(row)));
            }
            rows.forEach((row) => row.addEventListener("focus", () => browse(row)));

            // Bars fill as their panel comes into view.
            const bars = board.querySelectorAll<HTMLElement>(".skill-row .skill-bar-fill");
            const reveal = (el: HTMLElement) => {
                const p = parseFloat(el.dataset.proficiency || "0") / 100;
                el.style.setProperty("--p", String(p));
                el.style.transform = `scaleX(${p})`;
            };
            if ("IntersectionObserver" in window) {
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                reveal(entry.target as HTMLElement);
                                io.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.4 }
                );
                bars.forEach((bar) => io.observe(bar));
            } else {
                bars.forEach(reveal);
            }
        });
    </script>
</Layout>
