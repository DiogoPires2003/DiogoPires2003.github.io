    },
    {
        name: "Astro",
        category: "Frameworks",
        detail: "Content-focused web architecture",
        proficiency: 70,
    },
    {
        name: "Django",
        category: "Frameworks",
        detail: "Backend framework engineering",
        proficiency: 95,
    },
    {
        name: "Three.js",
        category: "Frameworks",
        detail: "3D web scene programming",
