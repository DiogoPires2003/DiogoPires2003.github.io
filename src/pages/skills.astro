---

<Layout title="Diogo Pires | Skills">
    <style is:inline>
        .cyber-grid {
            background-image: linear-gradient(
                    to right,
                    rgba(144, 0, 255, 0.05) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    to bottom,
                    rgba(144, 0, 255, 0.05) 1px,
                    transparent 1px
                );
            background-size: 40px 40px;
        }
        .node-line {
            background: linear-gradient(
                90deg,
                transparent,
                #9000ff,
                transparent
            );
            height: 1px;
            opacity: 0.3;
        }
        @media (max-width: 640px) {
            #constellation-area .tech-node > div > div {
                transform: scale(0.72);
                transform-origin: center;
            }
        }
    </style>
    <main
        class="flex-1 flex flex-col p-4 sm:p-6 lg:p-12 gap-6 sm:gap-8 max-w-7xl mx-auto w-full pt-14 sm:pt-16"
    >
        <!-- Hero Header -->
        <div
            class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-l-4 border-primary pl-6 py-4"
        >
            <div class="space-y-2">
                <p
                    class="text-primary font-bold text-xs tracking-[0.3em] uppercase"
                >
                    Status: Core_Online
                </p>
                <h1
                    class="text-3xl sm:text-5xl md:text-7xl font-display font-black leading-none uppercase italic"
                >
                    Tech_Stack.<br />Constellation
                </h1>
            </div>
            <div class="bg-primary text-white p-4 w-full max-w-xs brutalist-border">
                <p class="text-[10px] leading-tight font-bold uppercase mb-2">
                    System Instructions:
                </p>
                <p class="text-xs">
                    INTERACT WITH NODES TO DECODE PROFICIENCY LEVELS. DRAG
                    ELEMENTS TO RECONFIGURE ARCHITECTURE.
                </p>
            </div>
        </div>
        <!-- Filters -->
        <div class="hidden sm:flex flex-wrap gap-3" id="filter-container">
            <button
                data-filter="All Nodes"
                class="filter-btn px-4 sm:px-6 py-2 bg-primary text-white font-bold text-xs sm:text-sm tracking-widest hover:invert transition-all uppercase"
                >All Nodes</button
            >
            <button
                data-filter="Languages"
                class="filter-btn px-4 sm:px-6 py-2 border-2 border-primary text-primary font-bold text-xs sm:text-sm tracking-widest hover:bg-primary/10 transition-all uppercase"
                >Languages</button
            >
            <button
                data-filter="Frameworks"
                class="filter-btn px-4 sm:px-6 py-2 border-2 border-primary text-primary font-bold text-xs sm:text-sm tracking-widest hover:bg-primary/10 transition-all uppercase"
                >Frameworks</button
            >
            <button
                data-filter="Databases"
                class="filter-btn px-4 sm:px-6 py-2 border-2 border-primary text-primary font-bold text-xs sm:text-sm tracking-widest hover:bg-primary/10 transition-all uppercase"
