            </div>
            <div class="flex flex-col">
                <span class="text-[10px] uppercase opacity-50 font-bold"
                    >Last_Updated</span
                >
                <span class="text-xl font-bold tracking-tight text-green-500"
                    >{lastUpdated}</span
                >
            </div>
            <div class="flex flex-col">
                <span class="text-[10px] uppercase opacity-50 font-bold"
                    >Core_Focus</span
                >
                <span class="text-xl font-bold tracking-tight">Web & Systems</span>
            </div>
        </div>
    </main>
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const area = document.getElementById("constellation-area");
            const nodes = Array.from(document.querySelectorAll(".tech-node"));
            const svg = document.getElementById("connections-svg");
            const filterBtns = document.querySelectorAll(".filter-btn");
            const nodeCountLabel = document.getElementById("node-count-label");
            const cardFilterBtns = document.querySelectorAll(".card-filter-btn");
            const skillCards = Array.from(document.querySelectorAll(".skill-card"));
            const cardsScrollContainer = document.getElementById(
                "cards-scroll-container"
            );
            const cardsScrollLeft = document.getElementById("cards-scroll-left");
            const cardsScrollRight = document.getElementById("cards-scroll-right");
            const isMobile = window.matchMedia("(max-width: 639px)").matches;
            let activeFilter = "All Nodes";
            const containerPadding = 30;

            function layoutVisibleNodes() {
                const areaRect = area.getBoundingClientRect();
                const activeNodes = nodes.filter(
                    (node) => node.style.display !== "none"
                );

                if (!activeNodes.length || areaRect.width === 0) return;

                const centerX = areaRect.width / 2;
                const centerY = areaRect.height / 2;
                const spacing = 36;
                const isAllNodes = activeFilter === "All Nodes";
                const edgePadding = isAllNodes ? 62 : 36;
                const usableW = Math.max(1, areaRect.width - edgePadding * 2);
                const usableH = Math.max(1, areaRect.height - edgePadding * 2);
                const clampValue = (value, min, max) =>
                    Math.max(min, Math.min(max, value));
                const protectedZones = [
                    // Bottom-left telemetry text block
                    {
                        x: 8,
                        y: Math.max(0, areaRect.height - 96),
                        w: 250,
                        h: 92,
                    },
                    // Top-right stats text block
                    {
                        x: Math.max(0, areaRect.width - 210),
                        y: 8,
                        w: 202,
                        h: 84,
                    },
                ];
                const seed = activeNodes.length * 131 + activeFilter.length * 17;
                const rand = (n) => {
                    const v = Math.sin((n + seed) * 12.9898) * 43758.5453;
                    return v - Math.floor(v);
                };

                const state = activeNodes.map((node, index) => {
                    const rect = node.getBoundingClientRect();
                    const tx =
                        edgePadding +
                        rand(index * 2 + 1) * usableW +
                        (0.5 - rand(index * 2 + 3)) * 36;
                    const ty =
                        edgePadding +
                        rand(index * 2 + 2) * usableH +
                        (0.5 - rand(index * 2 + 4)) * 36;

                    const angle = index * 2.399963229728653; // Golden angle
                    const radius = Math.sqrt(index + 1) * 74;
                    return {
                        node,
                        w: rect.width,
                        h: rect.height,
                        r: Math.hypot(rect.width, rect.height) / 2 + spacing,
                        x: isAllNodes
                            ? tx
                            : centerX + Math.cos(angle) * radius,
                        y: isAllNodes
                            ? ty
                            : centerY + Math.sin(angle) * radius,
                        tx,
                        ty,
                    };
                });

                for (let step = 0; step < 280; step++) {
                    for (let i = 0; i < state.length; i++) {
                        const a = state[i];

                        if (isAllNodes) {
                            const chaosX = (rand(step * 911 + i * 31) - 0.5) * 0.7;
                            const chaosY = (rand(step * 733 + i * 47) - 0.5) * 0.7;
                            a.x += (a.tx - a.x) * 0.038 + chaosX;
                            a.y += (a.ty - a.y) * 0.038 + chaosY;
                        } else {
                            a.x += (centerX - a.x) * 0.016;
                            a.y += (centerY - a.y) * 0.016;
                        }

                        for (let j = i + 1; j < state.length; j++) {
                            const b = state[j];
                            let dx = b.x - a.x;
                            let dy = b.y - a.y;
                            let dist = Math.hypot(dx, dy);
                            const minDist = a.r + b.r;

                            if (dist < 0.001) {
                                const jitter = 0.5 - Math.random();
                                dx = jitter;
                                dy = 0.5 - Math.random();
                                dist = Math.hypot(dx, dy);
                            }

                            if (dist < minDist) {
                                const push = (minDist - dist) * 0.5;
                                const ux = dx / dist;
                                const uy = dy / dist;
                                a.x -= ux * push;
                                a.y -= uy * push;
                                b.x += ux * push;
                                b.y += uy * push;
                            }
                        }

                        const minX = a.w / 2 + containerPadding;
                        const maxX = areaRect.width - a.w / 2 - containerPadding;
                        const minY = a.h / 2 + containerPadding;
                        const maxY = areaRect.height - a.h / 2 - containerPadding;

                        for (const zone of protectedZones) {
                            const nearestX = clampValue(
                                a.x,
                                zone.x,
                                zone.x + zone.w
                            );
                            const nearestY = clampValue(
                                a.y,
                                zone.y,
                                zone.y + zone.h
                            );
                            let dx = a.x - nearestX;
                            let dy = a.y - nearestY;
                            let dist = Math.hypot(dx, dy);

                            if (dist < 0.001) {
                                dx = a.x - (zone.x + zone.w / 2);
                                dy = a.y - (zone.y + zone.h / 2);
                                dist = Math.hypot(dx, dy) || 1;
                            }

                            if (dist < a.r) {
                                const push = a.r - dist;
                                a.x += (dx / dist) * push;
                                a.y += (dy / dist) * push;
                            }
                        }

                        a.x = clampValue(a.x, minX, maxX);
                        a.y = clampValue(a.y, minY, maxY);
                    }
                }

                state.forEach((item) => {
                    const left = item.x - item.w / 2;
                    const top = item.y - item.h / 2;
                    item.node.style.left = `${(left / areaRect.width) * 100}%`;
                    item.node.style.top = `${(top / areaRect.height) * 100}%`;
                });
            }

            function drawConnections() {
                svg.innerHTML = "";
                const activeNodes = nodes.filter(
                    (n) => n.style.display !== "none"
                );

                for (let i = 0; i < activeNodes.length; i++) {
                    for (let j = i + 1; j < activeNodes.length; j++) {
                        const n1 = activeNodes[i];
                        const n2 = activeNodes[j];

                        const rect1 = n1.getBoundingClientRect();
                        const rect2 = n2.getBoundingClientRect();
                        const areaRect = area.getBoundingClientRect();

                        // Get centers
                        const x1 = rect1.left + rect1.width / 2 - areaRect.left;
                        const y1 = rect1.top + rect1.height / 2 - areaRect.top;
                        const x2 = rect2.left + rect2.width / 2 - areaRect.left;
                        const y2 = rect2.top + rect2.height / 2 - areaRect.top;

                        const dist = Math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2);

                        // Connect nodes within a reasonable visual distance
                        if (
                            dist < areaRect.width * 0.45 ||
                            activeNodes.length <= 3
                        ) {
                            const line = document.createElementNS(
                                "http://www.w3.org/2000/svg",
                                "line"
                            );
                            line.setAttribute("x1", x1);
                            line.setAttribute("y1", y1);
                            line.setAttribute("x2", x2);
                            line.setAttribute("y2", y2);
                            line.setAttribute("stroke", "#9000ff");
                            line.setAttribute("stroke-width", "1.5");
                            line.setAttribute(
                                "opacity",
                                Math.max(
                                    0.1,
                                    1 - dist / (areaRect.width * 0.45)
                                )
                            );
                            svg.appendChild(line);
                        }
                    }
                }
            }

            cardFilterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    cardFilterBtns.forEach((b) => {
                        b.classList.remove(
                            "bg-primary",
                            "text-white",
                            "hover:invert"
                        );
                        b.classList.add(
                            "border-primary",
                            "text-primary",
                            "hover:bg-primary/10"
                        );
                    });

                    btn.classList.add(
                        "bg-primary",
                        "text-white",
                        "hover:invert"
                    );
                    btn.classList.remove(
                        "border-primary",
                        "text-primary",
                        "hover:bg-primary/10"
                    );

                    const cat = btn.dataset.filter;
                    skillCards.forEach((card) => {
                        if (
                            cat === "All Nodes" ||
                            card.dataset.category === cat
                        ) {
                            card.style.display = "flex";
                        } else {
                            card.style.display = "none";
                        }
                    });
                    cardsScrollContainer.scrollTo({ left: 0, behavior: "smooth" });
                });
            });

            cardsScrollLeft?.addEventListener("click", () => {
                cardsScrollContainer?.scrollBy({
                    left: -360,
                    behavior: "smooth",
                });
            });

            cardsScrollRight?.addEventListener("click", () => {
                cardsScrollContainer?.scrollBy({
                    left: 360,
                    behavior: "smooth",
                });
            });

            if (isMobile || !area || !svg || !nodeCountLabel) {
                return;
            }

            nodeCountLabel.textContent = `NODE_COUNT: ${nodes.length}`;

            // Filtering logic
            filterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    filterBtns.forEach((b) => {
                        b.classList.remove(
                            "bg-primary",
                            "text-white",
                            "invert"
                        );
                        b.classList.add(
                            "border-primary",
                            "text-primary",
                            "hover:bg-primary/10"
                        );
                    });
                    btn.classList.add(
                        "bg-primary",
                        "text-white",
                        "hover:invert"
                    );
                    btn.classList.remove(
                        "border-primary",
                        "text-primary",
                        "hover:bg-primary/10"
                    );

                    const cat = btn.dataset.filter;
                    activeFilter = cat;
                    nodes.forEach((node) => {
                        if (
                            cat === "All Nodes" ||
                            node.dataset.category === cat
                        ) {
                            node.style.display = "block";
                        } else {
                            node.style.display = "none";
                        }
                    });

                    // Allow DOM to update visibility, then re-layout and redraw.
                    requestAnimationFrame(() =>
                        requestAnimationFrame(() => {
                            layoutVisibleNodes();
                            drawConnections();
                        })
                    );
                });
            });

            // Dragging capability logic
            let isDragging = false;
            let draggedNode = null;
            let offsetX = 0;
            let offsetY = 0;

            nodes.forEach((node) => {
                const mousedown = (e) => {
                    // Only start drag if interacting with the node itself, ignore right click
                    if (e.button !== undefined && e.button !== 0) return;
                    isDragging = true;
                    draggedNode = node;

                    const rect = node.getBoundingClientRect();
                    const clientX = e.touches
                        ? e.touches[0].clientX
                        : e.clientX;
                    const clientY = e.touches
                        ? e.touches[0].clientY
                        : e.clientY;

                    offsetX = clientX - rect.left;
                    offsetY = clientY - rect.top;

                    node.style.zIndex = 30; // Bring to front while dragging
                };

                node.addEventListener("mousedown", mousedown);
                node.addEventListener("touchstart", mousedown, {
                    passive: true,
                });
            });

            const move = (e) => {
                if (!isDragging || !draggedNode) return;

                const areaRect = area.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;

                let newX = clientX - areaRect.left - offsetX;
                let newY = clientY - areaRect.top - offsetY;

                const nodeRect = draggedNode.getBoundingClientRect();
                const maxX = areaRect.width - nodeRect.width - containerPadding;
                const maxY =
                    areaRect.height - nodeRect.height - containerPadding;
                newX = Math.max(containerPadding, Math.min(maxX, newX));
                newY = Math.max(containerPadding, Math.min(maxY, newY));

                draggedNode.style.left = `${(newX / areaRect.width) * 100}%`;
                draggedNode.style.top = `${(newY / areaRect.height) * 100}%`;

                drawConnections();
            };

            const up = () => {
                if (draggedNode) {
                    draggedNode.style.zIndex = 10;
                }
                isDragging = false;
                draggedNode = null;
            };

            document.addEventListener("mousemove", move);
            document.addEventListener("touchmove", move, { passive: false }); // passive false to prevent scrolling if needed
            document.addEventListener("mouseup", up);
            document.addEventListener("touchend", up);

            // Initial Drawing
            requestAnimationFrame(() =>
                requestAnimationFrame(() => {
                    layoutVisibleNodes();
                    drawConnections();
                })
            );
            window.addEventListener("resize", () => {
                layoutVisibleNodes();
                drawConnections();
            });
        });
    </script>
</Layout>
