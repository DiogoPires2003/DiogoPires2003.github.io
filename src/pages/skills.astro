---

<Layout title="Diogo Pires | Skills">
    <section data-reveal class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-20">
        <p class="eyebrow font-mono text-xs text-accent-text uppercase tracking-[0.25em] mb-6" data-scramble>
            N&deg; 02 &mdash; Technical Stack
        </p>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase leading-[0.95] tracking-[-0.035em] mb-6 max-w-3xl">
            <span class="reveal-line" style="--i:0"><span>Skills &amp; Tools<span class="text-accent stamp-dot">.</span></span></span>
        </h1>
        <p class="reveal-up max-w-2xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Languages, frameworks and tools I use regularly. Proficiency
            reflects hands-on academic and internship experience.
        </p>
    </section>

    <section class="px-4 sm:px-6 lg:px-12 py-6 border-b-2 border-ink dark:border-paper" id="filter-container">
        <div id="filter-group" class="relative isolate inline-flex flex-wrap">
        <span id="filter-ink" class="slide-ink" aria-hidden="true"></span>
        {filters.map((filter, i) => (
            <button
                data-filter={filter}
                class:list={[
                    "filter-btn tap-feedback px-5 py-2.5 font-mono text-xs uppercase tracking-widest border-2 border-ink dark:border-paper",
                    i > 0 && "border-l-0",
                    filter === "All" && "is-active",
                ]}
            >
                {filter}<span class="ml-2 opacity-50">{filter === "All" ? nodeCards.length : nodeCards.filter((c) => c.category === filter).length}</span>
            </button>
        ))}
        </div>
    </section>

    <section class="border-b-2 border-ink dark:border-paper" id="skill-grid">
        <div class="hidden lg:grid grid-cols-12 px-4 sm:px-6 lg:px-12 py-3 font-mono text-[11px] uppercase tracking-widest text-neutral-500 dark:text-neutral-400 border-b border-neutral-300 dark:border-neutral-700">
            <span class="col-span-1">No.</span>
            <button
                type="button"
                id="sort-name"
                class="sort-btn col-span-3 text-left flex items-center gap-1.5 hover:text-accent-text transition-colors"
            >
                Name <span class="sort-arrow" data-for="name"></span>
            </button>
            <span class="col-span-3">Detail</span>
            <span class="col-span-2">Category</span>
            <button
                type="button"
                id="sort-proficiency"
                class="sort-btn col-span-2 text-left flex items-center gap-1.5 hover:text-accent-text transition-colors"
            >
                Proficiency <span class="sort-arrow" data-for="proficiency"></span>
            </button>
            <span class="col-span-1 text-right">%</span>
        </div>
        {nodeCards.map((card, i) => (
            <div
                class="skill-row stagger-item is-shown row-wipe group grid grid-cols-12 items-center gap-x-2 px-4 sm:px-6 lg:px-12 py-4 sm:py-5 border-b border-neutral-300 dark:border-neutral-700 last:border-b-0"
                data-category={card.category}
                data-name={card.name}
                data-proficiency={card.proficiency}
            >
                <span class="skill-index hidden sm:block col-span-1 font-mono text-xs text-neutral-400">
                    {String(i + 1).padStart(2, "0")}
                </span>
                <span class="col-span-6 sm:col-span-3">
                    <span class="row-slide font-bold uppercase text-sm sm:text-base">{card.name}</span>
                    <span class="block sm:hidden text-xs text-neutral-500 dark:text-neutral-400">{card.detail}</span>
                </span>
                <span class="hidden sm:block col-span-3 text-sm text-neutral-500 dark:text-neutral-400">
                    {card.detail}
                </span>
                <span class="hidden sm:block col-span-2 font-mono text-[11px] uppercase text-accent-text">
                    [{card.category}]
                </span>
                <span class="col-span-5 sm:col-span-2">
                    <div class="skill-bar-track">
                        <div
                            class="skill-bar-fill"
                            data-proficiency={card.proficiency}
                            style={`--p: 0; transition-delay: ${(i % 10) * 30}ms;`}
                        >
                        </div>
                    </div>
                </span>
                <span class="col-span-1 text-right font-mono text-xs font-bold tabular-nums" data-count-text={card.proficiency} data-suffix="%">{card.proficiency}%</span>
            </div>
        ))}
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3">
        {stats.map((stat, i) => (
            <div
                data-reveal
                style={`--i:${i}`}
                class:list={[
                    "stat-line px-4 sm:px-6 lg:px-12 py-8 sm:py-10",
                    i !== stats.length - 1 && "sm:border-r border-neutral-300 dark:border-neutral-700",
                ]}
            >
                <span class="font-mono text-xs text-accent-text">{stat.n}</span>
                {stat.countTo !== undefined ? (
                    <p class="text-2xl sm:text-3xl font-black uppercase mt-3 flex items-baseline">
                        <number-flow class="stat-number" data-count-to={stat.countTo}></number-flow><span>{stat.countSuffix}</span>
                    </p>
                ) : (
                    <p class="text-2xl sm:text-3xl font-black uppercase mt-3">{stat.value}</p>
                )}
                <p class="text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mt-1">{stat.label}</p>
            </div>
        ))}
    </section>

    <script is:inline>
        document.addEventListener("astro:page-load", () => {
            const filterBtns = document.querySelectorAll(".filter-btn");
            const rows = Array.from(document.querySelectorAll(".skill-row"));

            const filterInk = document.getElementById("filter-ink");
            const moveFilterInk = (btn) => {
                if (!filterInk || !btn) return;
                filterInk.style.setProperty("--x", `${btn.offsetLeft}px`);
                filterInk.style.setProperty("--w", `${btn.offsetWidth}px`);
                filterInk.style.setProperty("--o", 1);
                filterInk.style.top = `${btn.offsetTop}px`;
                filterInk.style.height = `${btn.offsetHeight}px`;
            };
            moveFilterInk(document.querySelector(".filter-btn.is-active"));
            window.addEventListener("resize", () =>
                moveFilterInk(document.querySelector(".filter-btn.is-active"))
            );

            filterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    filterBtns.forEach((b) => b.classList.remove("is-active"));
                    btn.classList.add("is-active");
                    moveFilterInk(btn);

                    const cat = btn.dataset.filter;
                    const shown = [];

                    rows.forEach((row) => {
                        const shouldShow =
                            cat === "All" || row.dataset.category === cat;
                        if (shouldShow) {
                            const wasHidden = row.dataset.hidden === "true";
                            row.dataset.hidden = "false";
                            row.style.display = "grid";
                            if (wasHidden) {
                                row.classList.remove("is-shown");
                            }
                            shown.push(row);
                        } else {
                            row.dataset.hidden = "true";
                            row.classList.remove("is-shown");
                            window.setTimeout(() => {
                                if (row.dataset.hidden === "true") {
                                    row.style.display = "none";
                                }
                            }, 180);
                        }
                    });

                    // Visibility is already decided, so numbering must not
                    // wait on a frame callback.
                    renumber();

                    // Rows that are already on screen must not re-animate, so
                    // only the newcomers get a stagger delay. This waits a
                    // frame so the browser registers their hidden start state.
                    const entering = shown.filter(
                        (row) => !row.classList.contains("is-shown")
                    );
                    if (entering.length) {
                        requestAnimationFrame(() => {
                            if (window.__showStagger) {
                                window.__showStagger(entering, 24);
                            } else {
                                entering.forEach((row) =>
                                    row.classList.add("is-shown")
                                );
                            }
                        });
                    }
                });
            });

            // The leading number is a position in the current view, so it has
            // to be rewritten whenever the view changes.
            const renumber = () => {
                let n = 0;
                // Read from the DOM, not the captured array: sorting reorders
                // the rows and the number is a position in the current view.
                document.querySelectorAll(".skill-row").forEach((row) => {
                    if (row.dataset.hidden === "true") return;
                    n += 1;
                    const cell = row.querySelector(".skill-index");
                    if (cell) cell.textContent = String(n).padStart(2, "0");
                });
            };

            const skillGrid = document.getElementById("skill-grid");
            const sortButtons = document.querySelectorAll(".sort-btn");
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;
            let sortState = { field: null, dir: 1 };

            const updateSortArrows = () => {
                document
                    .querySelectorAll(".sort-arrow")
                    .forEach((el) => (el.textContent = ""));
                if (sortState.field) {
                    const arrow = document.querySelector(
                        `.sort-arrow[data-for="${sortState.field}"]`
                    );
                    if (arrow) {
                        arrow.textContent = sortState.dir === 1 ? "▲" : "▼";
                        arrow.classList.remove("icon-pop");
                        void arrow.offsetWidth;
                        arrow.classList.add("icon-pop");
                    }
                }
            };

            const sortRows = (field) => {
                if (sortState.field === field) {
                    sortState.dir *= -1;
                } else {
                    sortState.field = field;
                    sortState.dir = 1;
                }

                const sorted = [...rows].sort((a, b) => {
                    if (field === "name") {
                        const av = a.dataset.name.toLowerCase();
                        const bv = b.dataset.name.toLowerCase();
                        if (av < bv) return -1 * sortState.dir;
                        if (av > bv) return 1 * sortState.dir;
                        return 0;
                    }
                    const av = parseFloat(a.dataset.proficiency);
                    const bv = parseFloat(b.dataset.proficiency);
                    return (av - bv) * sortState.dir;
                });

                const visibleRows = sorted.filter(
                    (row) => row.dataset.hidden !== "true"
                );
                const firstRects = reduceMotion
                    ? null
                    : new Map(
                          visibleRows.map((row) => [row, row.getBoundingClientRect()])
                      );

                sorted.forEach((row) => skillGrid.appendChild(row));
                updateSortArrows();
                renumber();

                if (reduceMotion) return;

                requestAnimationFrame(() => {
                    visibleRows.forEach((row) => {
                        const first = firstRects.get(row);
                        const last = row.getBoundingClientRect();
                        const deltaY = first.top - last.top;
                        if (!deltaY) return;
                        if (window.__flipSpring) {
                            window.__flipSpring(row, deltaY);
                        }
                    });
                });
            };

            sortButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    sortRows(btn.id === "sort-name" ? "name" : "proficiency");
                });
            });

            const tracks = document.querySelectorAll(".skill-bar-track");
            if (tracks.length) {
                const revealBar = (track) => {
                    const el = track.querySelector(".skill-bar-fill");
                    if (!el) return;
                    const p = parseFloat(el.dataset.proficiency) / 100;
                    el.style.setProperty("--p", String(p));
                    el.style.transform = `scaleX(${p})`;
                };
                if ("IntersectionObserver" in window) {
                    const barObserver = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    revealBar(entry.target);
                                    barObserver.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.4 }
                    );
                    tracks.forEach((track) => barObserver.observe(track));
                } else {
                    tracks.forEach(revealBar);
                }
            }
        });
    </script>

    <script>
        import "number-flow";

        document.addEventListener("astro:page-load", () => {
            const stats = Array.from(
                document.querySelectorAll("number-flow[data-count-to]")
            );
            if (!stats.length) return;

            stats.forEach((el) => el.update(0));

            const reveal = (el) => el.update(parseFloat(el.dataset.countTo));

            if ("IntersectionObserver" in window) {
                const statObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                reveal(entry.target);
                                statObserver.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.4 }
                );
                stats.forEach((el) => statObserver.observe(el));
            } else {
                stats.forEach(reveal);
            }
        });
    </script>

    <script>
        import { animate } from "motion";

        // Motion's `x`/`y`/`translateY` shorthands run on the main thread.
        // The full transform string is hardware accelerated, which matters
        // while the rest of the table is reflowing.
        window.__flipSpring = function (row, deltaY) {
            const controls = animate(
                row,
                {
                    transform: [
                        `translateY(${deltaY}px)`,
                        "translateY(0px)",
                    ],
                },
                { type: "spring", duration: 0.45, bounce: 0.1 }
            );
            controls.finished
                .then(() => {
                    row.style.transform = "";
                })
                .catch(() => {});
        };
    </script>
</Layout>
