        </div>
        <!-- Constellation Visualizer Area -->
        <div
            class="sm:hidden grid grid-cols-1 gap-4"
            aria-label="Mobile skills node list"
        >
            {
                nodeCategories.map((category) => (
                    <section class="border-2 border-primary p-4 bg-background-light/70 dark:bg-background-dark/60">
                        <h2 class="text-sm font-black uppercase tracking-[0.2em] text-primary mb-3">
                            {category}
                        </h2>
                        <div class="grid grid-cols-1 gap-3">
                            {nodeCards
                                .filter((card) => card.category === category)
                                .map((card) => (
                                    <article class="border border-primary/40 p-3 bg-primary/5">
                                        <div class="flex items-center justify-between gap-3">
                                            <h3 class="font-bold text-sm uppercase tracking-wide">
                                                {card.name}
                                            </h3>
                                            <span class="text-[10px] opacity-60 font-bold">
                                                {card.id}
                                            </span>
                                        </div>
                                        <p class="text-[11px] opacity-70 uppercase mt-1">
                                            {card.detail}
                                        </p>
                                        <div class="w-full bg-slate-800 h-2 mt-3 border border-primary/40 overflow-hidden">
                                            <div
                                                class="bg-primary h-full"
                                                style={`width: ${card.proficiency}%;`}
