            <button
                data-filter="Tools"
                class="filter-btn px-4 sm:px-6 py-2 border-2 border-primary text-primary font-bold text-xs sm:text-sm tracking-widest hover:bg-primary/10 transition-all uppercase"
                >Tools</button
