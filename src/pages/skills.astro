const lastUpdated = new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
}).format(new Date());

const nodeCategories = [...new Set(nodeCards.map((card) => card.category))];
const filters = ["All", ...nodeCategories];

const stats = [
    {
        n: "01",
        value: "1.2M+",
        label: "Lines of code",
        countTo: 1.2,
        countSuffix: "M+",
        countDecimals: 1,
    },
    { n: "02", value: lastUpdated, label: "Last updated" },
    { n: "03", value: "Web & Systems", label: "Core focus" },
