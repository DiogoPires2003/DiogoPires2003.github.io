    },
    {
        name: "Python",
        category: "Languages",
        detail: "Automation & scripting",
        proficiency: 60,
    },
    {
        name: "JavaScript",
        category: "Languages",
        detail: "Web application logic",
        proficiency: 70,
    },
    {
        name: "TypeScript",
        category: "Languages",
        detail: "Typed frontend architecture",
        proficiency: 50,
    },
