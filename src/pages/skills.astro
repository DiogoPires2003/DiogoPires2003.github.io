        proficiency: 50,
    },
];

const lastUpdated = new Intl.DateTimeFormat("en-GB", {
    year: "numeric",
    month: "short",
    day: "2-digit",
}).format(new Date());

const nodeCategories = [...new Set(nodeCards.map((card) => card.category))];
const filters = ["All", ...nodeCategories];

const stats = [
    {
        n: "01",
        value: "1.2M+",
        label: "Lines of code",
        countTo: 1.2,
        countSuffix: "M+",
        countDecimals: 1,
    },
    { n: "02", value: lastUpdated, label: "Last updated" },
    { n: "03", value: "Web & Systems", label: "Core focus" },
];
---

<Layout title="Diogo Pires | Skills">
    <section class="border-b-2 border-ink dark:border-paper px-4 sm:px-6 lg:px-12 py-14 sm:py-20">
        <p class="font-mono text-xs text-accent uppercase tracking-[0.25em] mb-6">
            N&deg; 02 &mdash; Technical Stack
        </p>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase leading-[0.95] tracking-tight mb-6 max-w-3xl">
            Skills &amp; Tools<span class="text-accent">.</span>
        </h1>
        <p class="max-w-2xl text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Languages, frameworks and tools I use regularly. Proficiency
            reflects hands-on academic and internship experience.
        </p>
    </section>

    <section class="px-4 sm:px-6 lg:px-12 py-6 border-b-2 border-ink dark:border-paper flex flex-wrap gap-0" id="filter-container">
        {filters.map((filter, i) => (
            <button
                data-filter={filter}
                class:list={[
                    "filter-btn tap-feedback px-5 py-2.5 font-mono text-xs uppercase tracking-widest border-2 border-ink dark:border-paper transition-colors",
                    i > 0 && "border-l-0",
                    filter === "All"
                        ? "bg-ink text-paper dark:bg-paper dark:text-ink"
                        : "hover:bg-ink hover:text-paper dark:hover:bg-paper dark:hover:text-ink",
                ]}
            >
                {filter}
            </button>
        ))}
    </section>

    <section class="border-b-2 border-ink dark:border-paper" id="skill-grid">
        <div class="hidden lg:grid grid-cols-12 px-4 sm:px-6 lg:px-12 py-3 font-mono text-[11px] uppercase tracking-widest text-neutral-500 border-b border-neutral-300 dark:border-neutral-700">
            <span class="col-span-1">No.</span>
            <button
                type="button"
                id="sort-name"
                class="sort-btn col-span-3 text-left flex items-center gap-1.5 hover:text-accent transition-colors"
            >
                Name <span class="sort-arrow" data-for="name"></span>
            </button>
            <span class="col-span-3">Detail</span>
            <span class="col-span-2">Category</span>
            <button
                type="button"
                id="sort-proficiency"
                class="sort-btn col-span-2 text-left flex items-center gap-1.5 hover:text-accent transition-colors"
            >
                Proficiency <span class="sort-arrow" data-for="proficiency"></span>
            </button>
            <span class="col-span-1 text-right">%</span>
        </div>
        {nodeCards.map((card, i) => (
            <div
                class="skill-row grid grid-cols-12 items-center gap-x-2 px-4 sm:px-6 lg:px-12 py-4 sm:py-5 border-b border-neutral-300 dark:border-neutral-700 last:border-b-0 hover:bg-neutral-50 dark:hover:bg-neutral-900/60 transition-[background-color,color,opacity] duration-200 ease-out motion-reduce:transition-none"
                data-category={card.category}
                data-name={card.name}
                data-proficiency={card.proficiency}
            >
                <span class="hidden sm:block col-span-1 font-mono text-xs text-neutral-400">
                    {String(i + 1).padStart(2, "0")}
                </span>
                <span class="col-span-6 sm:col-span-3">
                    <span class="font-bold uppercase text-sm sm:text-base block">{card.name}</span>
                    <span class="sm:hidden text-xs text-neutral-500">{card.detail}</span>
                </span>
                <span class="hidden sm:block col-span-3 text-sm text-neutral-500">
                    {card.detail}
                </span>
                <span class="hidden sm:block col-span-2 font-mono text-[11px] uppercase text-accent">
                    [{card.category}]
                </span>
                <span class="col-span-5 sm:col-span-2">
                    <div class="h-1.5 w-full bg-neutral-200 dark:bg-neutral-800">
                        <div
                            class="skill-bar-fill h-full bg-ink dark:bg-paper transition-[width] duration-[600ms] ease-out motion-reduce:transition-none motion-reduce:duration-0"
                            data-target-width={card.proficiency}
                            style={`width: 0%; transition-delay: ${(i % 10) * 30}ms;`}
                        >
                        </div>
                    </div>
                </span>
                <span class="col-span-1 text-right font-mono text-xs font-bold">
                    {card.proficiency}%
                </span>
            </div>
        ))}
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3">
        {stats.map((stat, i) => (
            <div
                class:list={[
                    "px-4 sm:px-6 lg:px-12 py-8 sm:py-10",
                    i !== stats.length - 1 && "sm:border-r border-neutral-300 dark:border-neutral-700",
                ]}
            >
                <span class="font-mono text-xs text-accent">{stat.n}</span>
                {stat.countTo !== undefined ? (
                    <p
                        class="count-up text-2xl sm:text-3xl font-black uppercase mt-3"
                        data-count-to={stat.countTo}
                        data-count-suffix={stat.countSuffix}
                        data-count-decimals={stat.countDecimals}
                    >
                        0{stat.countSuffix}
                    </p>
                ) : (
                    <p class="text-2xl sm:text-3xl font-black uppercase mt-3">{stat.value}</p>
                )}
                <p class="text-xs uppercase tracking-widest text-neutral-500 mt-1">{stat.label}</p>
            </div>
        ))}
    </section>

    <script is:inline>
        document.addEventListener("astro:page-load", () => {
            const filterBtns = document.querySelectorAll(".filter-btn");
            const rows = Array.from(document.querySelectorAll(".skill-row"));

            filterBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    filterBtns.forEach((b) => {
                        b.classList.remove(
                            "bg-ink",
                            "text-paper",
                            "dark:bg-paper",
                            "dark:text-ink"
                        );
                        b.classList.add(
                            "hover:bg-ink",
                            "hover:text-paper",
                            "dark:hover:bg-paper",
                            "dark:hover:text-ink"
                        );
                    });
                    btn.classList.add(
                        "bg-ink",
                        "text-paper",
                        "dark:bg-paper",
                        "dark:text-ink"
                    );
                    btn.classList.remove(
                        "hover:bg-ink",
                        "hover:text-paper",
                        "dark:hover:bg-paper",
                        "dark:hover:text-ink"
                    );

                    const cat = btn.dataset.filter;
                    rows.forEach((row) => {
                        const shouldShow =
                            cat === "All" || row.dataset.category === cat;
                        if (shouldShow) {
                            if (row.style.display === "none") {
                                row.style.display = "grid";
                                row.style.opacity = "0";
                                requestAnimationFrame(() => {
                                    row.style.opacity = "1";
                                });
                            } else {
                                row.style.opacity = "1";
                            }
                        } else {
                            row.style.opacity = "0";
                            window.setTimeout(() => {
                                if (row.style.opacity === "0") {
                                    row.style.display = "none";
                                }
                            }, 200);
                        }
                    });
                });
            });

            const skillGrid = document.getElementById("skill-grid");
            const sortButtons = document.querySelectorAll(".sort-btn");
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;
            let sortState = { field: null, dir: 1 };

            const updateSortArrows = () => {
                document
                    .querySelectorAll(".sort-arrow")
                    .forEach((el) => (el.textContent = ""));
                if (sortState.field) {
                    const arrow = document.querySelector(
                        `.sort-arrow[data-for="${sortState.field}"]`
                    );
                    if (arrow) {
                        arrow.textContent = sortState.dir === 1 ? "▲" : "▼";
                        arrow.classList.remove("icon-pop");
                        void arrow.offsetWidth;
                        arrow.classList.add("icon-pop");
                    }
                }
            };

            const sortRows = (field) => {
                if (sortState.field === field) {
                    sortState.dir *= -1;
                } else {
                    sortState.field = field;
                    sortState.dir = 1;
                }

                const sorted = [...rows].sort((a, b) => {
                    if (field === "name") {
                        const av = a.dataset.name.toLowerCase();
                        const bv = b.dataset.name.toLowerCase();
                        if (av < bv) return -1 * sortState.dir;
                        if (av > bv) return 1 * sortState.dir;
                        return 0;
                    }
                    const av = parseFloat(a.dataset.proficiency);
                    const bv = parseFloat(b.dataset.proficiency);
                    return (av - bv) * sortState.dir;
                });

                const visibleRows = sorted.filter(
                    (row) => row.style.display !== "none"
                );
                const firstRects = reduceMotion
                    ? null
                    : new Map(
                          visibleRows.map((row) => [row, row.getBoundingClientRect()])
                      );

                sorted.forEach((row) => skillGrid.appendChild(row));
                updateSortArrows();

                if (reduceMotion) return;

                requestAnimationFrame(() => {
                    visibleRows.forEach((row) => {
                        const first = firstRects.get(row);
                        const last = row.getBoundingClientRect();
                        const deltaY = first.top - last.top;
                        if (!deltaY) return;
                        row.style.transition = "none";
                        row.style.transform = `translateY(${deltaY}px)`;
                        requestAnimationFrame(() => {
                            row.style.transition =
                                "transform 250ms cubic-bezier(0.22, 1, 0.36, 1)";
                            row.style.transform = "";
                            row.addEventListener(
                                "transitionend",
                                function handler(event) {
                                    if (event.propertyName !== "transform") return;
                                    row.style.transition = "";
                                    row.removeEventListener("transitionend", handler);
                                }
                            );
                        });
                    });
                });
            };

            sortButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    sortRows(btn.id === "sort-name" ? "name" : "proficiency");
                });
            });

            const bars = document.querySelectorAll(".skill-bar-fill");
            if (bars.length) {
                const revealBar = (el) => {
                    el.style.width = `${el.dataset.targetWidth}%`;
                };
                if ("IntersectionObserver" in window) {
                    const barObserver = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    revealBar(entry.target);
                                    barObserver.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.4 }
                    );
                    bars.forEach((bar) => barObserver.observe(bar));
                } else {
                    bars.forEach(revealBar);
                }
            }
        });
    </script>
</Layout>
